import { Theme, Space, Type, Motion, Layout } from "theme.slint";
import { Avatar, Btn, IconBtn, Chip, Segmented, Badge, EmptyState, Spinner, BusySlot, Texture } from "components.slint";
import { DetailItem } from "types.slint";
import { ScrollView } from "std-widgets.slint";

export struct AccountRow {
    id: string,
    name: string,
    username: string,
    avatar: image,
    active: bool,
}

component Toggle inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled();

    width: 38px;
    height: 21px;
    border-radius: Theme.radius == 0px ? 0px : 11px;
    background: root.on ? Theme.accent : Theme.bg_4;
    opacity: root.enabled ? 1.0 : 0.4;
    animate background { duration: Motion.fast; easing: Motion.ease; }

    Rectangle {
        width: 15px;
        height: 15px;
        y: 3px;
        x: root.on ? parent.width - self.width - 3px : 3px;
        background: root.on ? Theme.on_accent : Theme.text_dim;
        border-radius: Theme.radius == 0px ? 0px : 8px;
        animate x, background { duration: Motion.fast; easing: Motion.ease; }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

component Row inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    /// Optional explanation, revealed by hovering the "?" beside the title.
    in property <string> help;
    height: Math.max(46px, rlay.preferred-height + Space.sm * 2);

    rlay := HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        spacing: Space.lg;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: Space.sm;
                alignment: start;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Type.body;
                }
                // Mounted even with no help text: an id declared inside an
                // `if` cannot be read from a sibling, and the hint below needs
                // this TouchArea's hover state.
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        visible: root.help != "";
                        width: root.help != "" ? 15px : 0px;
                        height: 15px;
                        border-radius: 8px;
                        border-width: Theme.hairline;
                        border-color: hta.has-hover ? Theme.accent : Theme.line_strong;
                        animate border-color { duration: Motion.fast; easing: Motion.ease; }
                        Text {
                            text: "?";
                            color: hta.has-hover ? Theme.accent : Theme.text_mute;
                            font-size: Type.micro;
                            font-weight: Type.w_bold;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            animate color { duration: Motion.fast; easing: Motion.ease; }
                        }
                        hta := TouchArea { mouse-cursor: pointer; }
                    }
                }
            }
            if hta.has-hover: Text {
                text: root.help;
                color: Theme.text_dim;
                font-size: Type.caption;
                wrap: word-wrap;
            }
            if root.hint != "": Text {
                text: root.hint;
                color: Theme.text_mute;
                font-size: Type.caption;
                wrap: word-wrap;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        @children
    }
}

component Card inherits Rectangle {
    in property <string> title;
    background: Theme.bg_1;
    border-radius: Theme.radius;
    border-width: Theme.hairline;
    border-color: Theme.line;
    height: clay.preferred-height;

    clay := VerticalLayout {
        padding-top: Space.md;
        padding-bottom: Space.md;
        spacing: Space.xs;

        Text {
            x: Space.lg;
            text: root.title;
            color: Theme.text_mute;
            font-size: Type.micro;
            font-weight: Type.w_bold;
            letter-spacing: 0.8px;
        }
        @children
    }
}

export component SettingsScreen inherits Rectangle {
    in property <[AccountRow]> accounts;
    in property <[DetailItem]> shortcuts;
    in property <int> server_page;      // index into 10/25/50/100
    in property <int> timeout_choice;   // index into 10/20/45/90
    in property <int> cache_choice;     // index into 100/400/800/2000
    in property <bool> verbose_logging;
    in property <bool> auto_update;
    in property <bool> has_client: false;
    callback open_client();
    callback set_server_page(int);
    callback set_timeout_choice(int);
    callback set_cache_choice(int);
    callback set_verbose_logging(bool);
    callback set_auto_update(bool);
    callback open_log();
    in property <[DetailItem]> notify_friends;
    in property <[DetailItem]> notify_games;
    in property <bool> dark: true;
    in property <bool> notify_requests: false;
    in property <bool> link_handler: false;
    in property <string> app_version;
    in property <string> data_dir;
    in property <string> update_status;
    in property <bool> checking_update: false;

    in property <bool> macros_enabled: true;
    in property <bool> only_when_focused: true;
    in property <bool> focus_detectable: true;
    in property <string> panic_key;
    in property <bool> binding_panic: false;
    in property <string> macro_backend;
    in property <float> ui_scale: 1.0;
    in property <[string]> sections;
    in property <int> startup_section: 0;
    in property <int> presence_secs: 60;
    in property <bool> confirm_destructive: true;
    in property <string> cache_summary;
    in property <bool> show_friends: true;
    in property <bool> show_hero: true;
    in property <bool> show_pinned: true;
    in property <bool> show_recent: true;
    in property <bool> show_favorites: true;

    callback switch_account(string);
    callback remove_account(string);
    callback add_account();
    callback set_dark(bool);
    callback set_notify_requests(bool);
    callback set_link_handler(bool);
    callback unsub_friend(string);
    callback remove_shortcut(string);
    callback unsub_game(string);
    callback open_data_dir();
    callback check_update();
    callback set_macros_enabled(bool);
    callback set_only_when_focused(bool);
    callback bind_panic_key();
    callback set_ui_scale(float);
    callback set_startup_section(int);
    callback set_presence_secs(int);
    callback set_confirm_destructive(bool);
    callback clear_caches();
    callback toggle_home_section(int);

    background: Theme.bg_0;

    Texture { width: 100%; height: 100%; }

    VerticalLayout {
        spacing: 0;

        Rectangle {
            height: 56px;
            background: Theme.bg_1;
            HorizontalLayout {
                padding-left: Space.lg;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Settings";
                        color: Theme.text;
                        font-size: Type.title;
                        font-weight: Type.w_bold;
                    }
                }
            }
        }
        Rectangle { height: Theme.hairline; background: Theme.line; }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: Space.xl;
                spacing: Space.lg;
                alignment: start;

                Card {
                    title: "ACCOUNTS";
                    for a in root.accounts: Rectangle {
                        height: 52px;
                        background: ata.has-hover ? Theme.bg_2 : transparent;
                        animate background { duration: Motion.instant; easing: Motion.ease; }

                        // Declared FIRST on purpose. This TouchArea exists only
                        // to light the row on hover, but it fills the row, and a
                        // later sibling sits above an earlier one — so with it
                        // last it swallowed every click on Switch and ×, which
                        // is exactly why neither button did anything.
                        ata := TouchArea { mouse-cursor: pointer; }

                        HorizontalLayout {
                            padding-left: Space.lg;
                            padding-right: Space.lg;
                            spacing: Space.md;

                            VerticalLayout {
                                alignment: center;
                                Avatar { source: a.avatar; size_px: 30px; }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                Text {
                                    text: a.name;
                                    color: Theme.text;
                                    font-size: Type.body;
                                    font-weight: a.active ? Type.w_bold : Type.w_regular;
                                }
                                Text {
                                    text: "@" + a.username;
                                    color: Theme.text_mute;
                                    font-size: Type.caption;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if a.active: VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "ACTIVE";
                                    color: Theme.accent;
                                    font-size: Type.micro;
                                    font-weight: Type.w_bold;
                                }
                            }
                            if !a.active: VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    spacing: Space.xs;
                                    Btn {
                                        label: "Switch";
                                        clicked => { root.switch_account(a.id); }
                                    }
                                    IconBtn {
                                        glyph: "×";
                                        clicked => { root.remove_account(a.id); }
                                    }
                                }
                            }
                        }
                    }

                    Row {
                        title: "Add another account";
                        VerticalLayout {
                            alignment: center;
                            Btn { label: "Add"; primary: true; clicked => { root.add_account(); } }
                        }
                    }
                }

                Card {
                    title: "HOME";
                    Row {
                        title: "Friends";
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                on: root.show_friends;
                                toggled => { root.toggle_home_section(0); }
                            }
                        }
                    }
                    Row {
                        title: "Jump back in";
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                on: root.show_hero;
                                toggled => { root.toggle_home_section(1); }
                            }
                        }
                    }
                    Row {
                        title: "Pinned";
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                on: root.show_pinned;
                                toggled => { root.toggle_home_section(2); }
                            }
                        }
                    }
                    Row {
                        title: "Recently played";
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                on: root.show_recent;
                                toggled => { root.toggle_home_section(3); }
                            }
                        }
                    }
                    Row {
                        title: "Favourites";
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                on: root.show_favorites;
                                toggled => { root.toggle_home_section(4); }
                            }
                        }
                    }
                }

                Card {
                    title: "APPEARANCE";
                    Row {
                        title: "Dark theme";
                        VerticalLayout {
                            alignment: center;
                            Toggle { on: root.dark; toggled => { root.set_dark(!root.dark); } }
                        }
                    }
                }

                Card {
                    title: "NOTIFICATIONS";
                    Row {
                        title: "Friend requests";
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                on: root.notify_requests;
                                toggled => { root.set_notify_requests(!root.notify_requests); }
                            }
                        }
                    }

                    Row {
                        title: "Watched friends";
                        help: "Friends you have starred with the bell. RoJoin notifies you when one of them comes online or joins a game.";
                        hint: root.notify_friends.length == 0
                              ? "None. Use the bell on a friend to watch them."
                              : root.notify_friends.length + " watched";
                    }
                    for f in root.notify_friends: Rectangle {
                        height: 36px;
                        HorizontalLayout {
                            padding-left: Space.xxl;
                            padding-right: Space.lg;
                            spacing: Space.sm;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: f.name;
                                    color: Theme.text_dim;
                                    font-size: Type.small;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout {
                                alignment: center;
                                IconBtn { glyph: "×"; clicked => { root.unsub_friend(f.id); } }
                            }
                        }
                    }

                    Row {
                        title: "Watched games";
                        help: "Games you have starred with the bell. RoJoin notifies you when a friend starts playing one of them.";
                        hint: root.notify_games.length == 0
                              ? "None. Use the bell on a game page to watch it."
                              : root.notify_games.length + " watched";
                    }
                    for g in root.notify_games: Rectangle {
                        height: 36px;
                        HorizontalLayout {
                            padding-left: Space.xxl;
                            padding-right: Space.lg;
                            spacing: Space.sm;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: g.name;
                                    color: Theme.text_dim;
                                    font-size: Type.small;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout {
                                alignment: center;
                                IconBtn { glyph: "×"; clicked => { root.unsub_game(g.id); } }
                            }
                        }
                    }
                }

                Card {
                    title: "SYSTEM";
                    Row {
                        title: "Open roblox:// links with RoJoin";
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                on: root.link_handler;
                                toggled => { root.set_link_handler(!root.link_handler); }
                            }
                        }
                    }
                    Row {
                        title: "Data folder";
                        VerticalLayout {
                            alignment: center;
                            Btn { label: "Open"; clicked => { root.open_data_dir(); } }
                        }
                    }
                }

                Card {
                    title: "MACROS";
                    Row {
                        title: "Macros enabled";
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                on: root.macros_enabled;
                                toggled => { root.set_macros_enabled(!root.macros_enabled); }
                            }
                        }
                    }
                    Row {
                        title: "Only while Roblox is focused";
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                on: root.only_when_focused && root.focus_detectable;
                                enabled: root.focus_detectable;
                                toggled => { root.set_only_when_focused(!root.only_when_focused); }
                            }
                        }
                    }
                    Row {
                        title: "Panic key";
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 110px;
                                height: 28px;
                                background: root.binding_panic ? Theme.accent_soft : Theme.bg_2;
                                border-radius: Theme.radius;
                                border-width: Theme.hairline;
                                border-color: root.binding_panic ? Theme.accent : Theme.line;
                                animate background, border-color { duration: Motion.fast; easing: Motion.ease; }
                                Text {
                                    text: root.binding_panic ? "Press a key…" : root.panic_key;
                                    color: root.binding_panic ? Theme.accent : Theme.text;
                                    font-size: Type.caption;
                                    font-weight: Type.w_medium;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.bind_panic_key(); }
                                }
                            }
                        }
                    }
                    Row {
                        title: "Input backend";
                    }
                }

                Card {
                    title: "INTERFACE";
                    Row {
                        title: "Interface size";
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: Space.xs;
                                for opt[i] in [
                                    { label: "Small", value: 0.9 },
                                    { label: "Normal", value: 1.0 },
                                    { label: "Large", value: 1.15 },
                                    { label: "Larger", value: 1.3 },
                                ]: Chip {
                                    label: opt.label;
                                    selected: Math.abs(root.ui_scale - opt.value) < 0.02;
                                    clicked => { root.set_ui_scale(opt.value); }
                                }
                            }
                        }
                    }
                    Row {
                        title: "Open on launch";
                        VerticalLayout {
                            alignment: center;
                            Segmented {
                                options: root.sections;
                                current: root.startup_section;
                                changed(i) => { root.set_startup_section(i); }
                            }
                        }
                    }
                    Row {
                        title: "Confirm before destructive actions";
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                on: root.confirm_destructive;
                                toggled => { root.set_confirm_destructive(!root.confirm_destructive); }
                            }
                        }
                    }
                }

                Card {
                    title: "DESKTOP SHORTCUTS";
                    Row {
                        title: "Shortcuts on your desktop";
                        help: "Made from a game's page with the shortcut button. Clicking one launches Roblox straight into that game.";
                        hint: root.shortcuts.length == 0
                              ? "None yet."
                              : root.shortcuts.length + " on your desktop";
                    }
                    for sc in root.shortcuts: Rectangle {
                        height: 36px;
                        HorizontalLayout {
                            padding-left: Space.xxl;
                            padding-right: Space.lg;
                            spacing: Space.sm;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: sc.name;
                                    color: Theme.text_dim;
                                    font-size: Type.small;
                                    overflow: elide;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout {
                                alignment: center;
                                IconBtn { glyph: "×"; clicked => { root.remove_shortcut(sc.id); } }
                            }
                        }
                    }
                }

                Card {
                    title: "NETWORK";
                    Row {
                        title: "Friend refresh";
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: Space.xs;
                                for opt[i] in [
                                    { label: "30s", value: 30 },
                                    { label: "1m", value: 60 },
                                    { label: "2m", value: 120 },
                                    { label: "5m", value: 300 },
                                ]: Chip {
                                    label: opt.label;
                                    selected: root.presence_secs == opt.value;
                                    clicked => { root.set_presence_secs(opt.value); }
                                }
                            }
                        }
                    }
                    Row {
                        title: "Cached data";
                        VerticalLayout {
                            alignment: center;
                            Btn { label: "Clear"; clicked => { root.clear_caches(); } }
                        }
                    }
                }

                if root.has_client: Card {
                    title: "ROBLOX CLIENT";
                    Row {
                        title: "Client settings and FastFlags";
                        help: "Renderer, Discord activity and engine flags. These belong to the Roblox client, not to RoJoin.";
                        VerticalLayout {
                            alignment: center;
                            Btn { label: "Open"; clicked => { root.open_client(); } }
                        }
                    }
                }

                Card {
                    title: "ADVANCED";
                    Row {
                        title: "Servers per page";
                        help: "How many servers to request for a game's server list. Roblox only accepts these four sizes.";
                        VerticalLayout {
                            alignment: center;
                            Segmented {
                                options: ["10", "25", "50", "100"];
                                current: root.server_page;
                                changed(i) => { root.set_server_page(i); }
                            }
                        }
                    }
                    Row {
                        title: "Request timeout";
                        help: "Seconds before an API call is given up on. Raise it on a slow connection; lower it if you would rather fail fast.";
                        VerticalLayout {
                            alignment: center;
                            Segmented {
                                options: ["10s", "20s", "45s", "90s"];
                                current: root.timeout_choice;
                                changed(i) => { root.set_timeout_choice(i); }
                            }
                        }
                    }
                    Row {
                        title: "Thumbnail cache";
                        help: "Images kept in memory before the oldest are dropped. Higher uses more RAM and re-downloads less.";
                        VerticalLayout {
                            alignment: center;
                            Segmented {
                                options: ["100", "400", "800", "2000"];
                                current: root.cache_choice;
                                changed(i) => { root.set_cache_choice(i); }
                            }
                        }
                    }
                    Row {
                        title: "Update automatically";
                        help: "Downloads a new release in the background and uses it the next time you start RoJoin.";
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                on: root.auto_update;
                                toggled => { root.set_auto_update(!root.auto_update); }
                            }
                        }
                    }
                    Row {
                        title: "Verbose logging";
                        help: "Records debug detail and writes it to rojoin.log in the data folder. Useful when something fails silently. Applies on next start.";
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                on: root.verbose_logging;
                                toggled => { root.set_verbose_logging(!root.verbose_logging); }
                            }
                        }
                    }
                    Row {
                        title: "Log file";
                        VerticalLayout {
                            alignment: center;
                            Btn { label: "Open"; clicked => { root.open_log(); } }
                        }
                    }
                }

                Card {
                    title: "ABOUT";
                    Row {
                        title: "RoJoin " + root.app_version;
                        hint: root.update_status;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 148px;
                                height: 32px;
                                if root.checking_update: Spinner {
                                    size_px: 16px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                                if !root.checking_update: Btn {
                                    label: "Check for updates";
                                    clicked => { root.check_update(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
