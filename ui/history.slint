import { Theme, Space, Type, Motion } from "theme.slint";
import { Btn, Segmented, Spinner, EmptyState } from "components.slint";

/// One column of the player-history chart.
///
/// Positions are pre-normalised to 0..1 by the Rust side: Slint has no business
/// knowing about unix timestamps or peak player counts, and doing the maths
/// once is cheaper than doing it per column on every repaint.
export struct HistoryPoint {
    x: float,
    height: float,
    label: string,      // "Fri 14 Aug · 12.4K players"
}

export struct HistoryStat {
    label: string,
    value: string,
}

/// Concurrent players over time, from what RoJoin has observed itself.
///
/// Drawn as a dense column chart rather than a stroked line: it reads the same
/// at this size, needs no path geometry, and every column is its own hover
/// target — which is how the readout works without a floating tooltip that
/// would need positioning and clipping.
export component PlayerHistory inherits Rectangle {
    in property <[HistoryPoint]> points;
    /// Your own playtime for this game, on the same buckets as `points`.
    in property <[HistoryPoint]> mine;
    in property <string> mine_label;
    /// The same data as paths, for the line rendering.
    in property <string> line;
    in property <string> mine_line;
    /// 0 = bars · 1 = line
    in-out property <int> style: 0;
    callback style_changed(int);
    in property <[HistoryStat]> stats;
    in property <string> peak_label;
    in property <string> range_label;
    in property <bool> loading: false;
    in property <string> error;
    /// Fewest columns worth drawing. Below this the plot is a couple of solid
    /// blocks at near-identical heights, which looks broken rather than young —
    /// so the numbers are shown and the chart waits.
    property <int> min_columns: 8;
    /// Range buttons, built from how much data exists — a "1 year" option over
    /// a minute of samples draws an empty plot and reads as broken.
    in property <[string]> ranges: ["All"];
    /// Index into `ranges`.
    in-out property <int> range: 0;
    callback range_changed(int);
    callback retry();
    /// Opens the game's Rolimons page in a browser. A link, not a fetch —
    /// their terms forbid automated access to their data, but pointing someone
    /// at their site is just a link, and it sends them the visit.
    callback open_rolimons();

    property <float> grow: 0.0;
    animate grow { duration: 600ms; easing: ease-out-quad; }
    init => { self.grow = 1.0; }

    /// What the pointer is over, shown in the header so nothing floats.
    property <string> hover;

    VerticalLayout {
        spacing: Space.md;

        HorizontalLayout {
            spacing: Space.sm;

            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text {
                    text: "Players over time";
                    color: Theme.text;
                    font-size: Type.small;
                    font-weight: Type.w_bold;
                }
                Text {
                    text: root.hover != "" ? root.hover : root.range_label;
                    color: root.hover != "" ? Theme.accent : Theme.text_mute;
                    font-size: Type.caption;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            VerticalLayout {
                alignment: center;
                // Hidden when there is only one choice: a lone button that
                // cannot be unselected is decoration.
                Segmented {
                    options: ["Bars", "Line"];
                    current <=> root.style;
                    changed(i) => { root.style_changed(i); }
                }
            }

            VerticalLayout {
                alignment: center;
                if root.ranges.length > 1: Segmented {
                    options: root.ranges;
                    current <=> root.range;
                    changed(i) => { root.range_changed(i); }
                }
            }
        }

        if root.loading: Rectangle {
            height: 150px;
            Spinner {
                size_px: 22px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        if !root.loading && root.error != "": Rectangle {
            height: 150px;
            VerticalLayout {
                alignment: center;
                spacing: Space.sm;
                Text {
                    text: root.error;
                    color: Theme.text_mute;
                    font-size: Type.caption;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: center;
                    Btn { label: "Try again"; clicked => { root.retry(); } }
                }
            }
        }

        if !root.loading && root.error == "" && root.points.length == 0: Rectangle {
            height: 150px;
            VerticalLayout {
                alignment: center;
                spacing: Space.xxs;
                Text {
                    text: "Nothing recorded yet";
                    color: Theme.text_dim;
                    font-size: Type.body;
                    font-weight: Type.w_medium;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Roblox does not share a game's past, so RoJoin notes what it "
                          + "sees each time you open a game. Come back after a few visits.";
                    color: Theme.text_mute;
                    font-size: Type.caption;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    max-width: 420px;
                }
            }
        }

        if !root.loading && root.error == "" && root.points.length > 0
           && root.points.length < root.min_columns: Rectangle {
            height: 96px;
            VerticalLayout {
                alignment: center;
                spacing: Space.xxs;
                Text {
                    text: "Still collecting";
                    color: Theme.text_dim;
                    font-size: Type.body;
                    font-weight: Type.w_medium;
                    horizontal-alignment: center;
                }
                Text {
                    text: "The chart appears once there are a few hours of readings. "
                          + "Favourites update in the background while RoJoin runs.";
                    color: Theme.text_mute;
                    font-size: Type.caption;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    max-width: 420px;
                }
            }
        }

        if !root.loading && root.error == "" && root.points.length >= root.min_columns: VerticalLayout {
            spacing: Space.xs;

            HorizontalLayout {
                Text {
                    text: root.peak_label;
                    color: Theme.text_mute;
                    font-size: Type.micro;
                }
                Rectangle { horizontal-stretch: 1; }
            }

            plot := Rectangle {
                height: 150px;

                Rectangle {
                    y: parent.height - Theme.hairline;
                    height: Theme.hairline;
                    background: Theme.line;
                }

                for p[i] in root.points: Rectangle {
                    // Bar width from the count, capped, and then *packed* rather
                    // than spread across the plot. Spreading a handful of capped
                    // bars edge to edge left them as lonely spikes with vast
                    // gaps; packed and centred they read as one chart.
                    property <length> colw: plot.width / max(1, root.points.length);
                    property <length> barw: max(1px, min(self.colw, 22px));
                    property <length> gap: self.barw >= 8px ? 2px : 0px;
                    property <length> stride: self.barw + self.gap;
                    // Left-aligned: a part-filled chart should grow rightwards
                    // from the axis like a chart that is filling up, not float in
                    // the middle of the plot.
                    // Same loop for both styles. A bar fills from the axis to
                    // the value; a "line" is a short cap left at the value, which
                    // traces the identical curve without any path geometry — and
                    // a near-flat SVG path came out invisible when tried.
                    property <length> top: plot.height
                        - plot.height * p.height * root.grow;

                    x: i * self.stride;
                    width: self.barw;
                    height: root.style == 0 ? max(1px, plot.height - self.top) : 3px;
                    y: root.style == 0 ? self.top : max(0px, self.top - 1px);

                    background: cta.has-hover ? Theme.text : Theme.accent;
                    // Lighter than the app's usual accent use: this is a large
                    // filled area, and at full strength it dominates the page
                    // rather than informing it.
                    opacity: cta.has-hover ? 1.0 : 0.62;
                    animate background, opacity { duration: Motion.instant; easing: Motion.ease; }

                    cta := TouchArea {
                        mouse-cursor: default;
                        changed has-hover => {
                            root.hover = self.has-hover ? p.label : "";
                        }
                    }
                }
            }
        }

        // Your own playtime, on its own strip sharing the x axis. Not overlaid:
        // minutes and concurrent players are different units, and one axis for
        // both would invite a comparison that means nothing.
        if !root.loading && root.error == "" && root.mine.length > 0
           && root.points.length >= root.min_columns: VerticalLayout {
            spacing: 2px;

            Text {
                text: root.mine_label;
                color: Theme.text_mute;
                font-size: Type.micro;
            }

            mineplot := Rectangle {
                height: 40px;

                Rectangle {
                    y: parent.height - Theme.hairline;
                    height: Theme.hairline;
                    background: Theme.line;
                }


                for p[i] in root.mine: Rectangle {
                    // Identical geometry to the plot above, so the two strips
                    // stay column-for-column aligned.
                    property <length> colw: mineplot.width / max(1, root.mine.length);
                    property <length> barw: max(1px, min(self.colw, 22px));
                    property <length> gap: self.barw >= 8px ? 2px : 0px;
                    property <length> stride: self.barw + self.gap;
                    property <length> top: mineplot.height
                        - mineplot.height * p.height * root.grow;

                    x: i * self.stride;
                    width: self.barw;
                    height: root.style == 0
                        ? max(p.height > 0.0 ? 2px : 0px, mineplot.height - self.top)
                        : (p.height > 0.0 ? 3px : 0px);
                    y: root.style == 0 ? self.top : max(0px, self.top - 1px);

                    // A different hue from the player series on purpose, so the
                    // two strips are never mistaken for the same measurement.
                    background: mta.has-hover ? #FFFFFF : #E0A82E;
                    opacity: mta.has-hover ? 1.0 : 0.75;
                    animate background, opacity { duration: Motion.instant; easing: Motion.ease; }

                    mta := TouchArea {
                        mouse-cursor: default;
                        changed has-hover => {
                            root.hover = self.has-hover ? p.label : "";
                        }
                    }
                }
            }
        }

        if root.stats.length > 0: HorizontalLayout {
            spacing: Space.md;
            for s in root.stats: Rectangle {
                horizontal-stretch: 1;
                height: 54px;
                background: Theme.bg_2;
                border-radius: Theme.radius;
                border-width: Theme.hairline;
                border-color: Theme.line;
                VerticalLayout {
                    padding: Space.sm;
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: s.value;
                        color: Theme.text;
                        font-size: Type.lead;
                        font-weight: Type.w_bold;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                    Text {
                        text: s.label;
                        color: Theme.text_mute;
                        font-size: Type.micro;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: Space.sm;
            VerticalLayout {
                alignment: center;
                Text {
                    text: "Recorded by RoJoin as you browse";
                    color: Theme.text_mute;
                    font-size: Type.micro;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Btn {
                label: "Full history on Rolimons ↗";
                pad_h: Space.md;
                clicked => { root.open_rolimons(); }
            }
        }
    }
}
