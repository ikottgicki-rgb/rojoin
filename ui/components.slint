import { Theme, Space, Type, Motion, Layout } from "theme.slint";

export component Spinner inherits Rectangle {
    in property <length> size_px: 16px;
    in property <color> tint: Theme.text_dim;

    width: root.size_px;
    height: root.size_px;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: root.size_px / 8;
        alignment: center;

        for d[idx] in [0, 1, 2]: Rectangle {
            width: root.size_px / 4;
            y: (parent.height - self.height) / 2;
            height: root.size_px / 4;
            background: root.tint;
            border-radius: Theme.radius;
            opacity: 0.25;
            animate opacity {
                duration: 560ms;
                iteration-count: -1;
                direction: alternate;
                easing: ease-in-out;
                delay: idx * 160ms;
            }
            init => { self.opacity = 1.0; }
        }
    }
}

/// A fixed-size slot that shows a spinner while busy and its child otherwise.
/// Using this instead of two sibling `if`s keeps the row from reflowing.
export component BusySlot inherits Rectangle {
    in property <bool> busy;
    in property <length> slot: 30px;

    width: root.slot;
    height: root.slot;

    Rectangle {
        width: 100%;
        height: 100%;
        visible: !root.busy;
        @children
    }

    if root.busy: Spinner {
        size_px: root.slot / 2;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

/// A bell, drawn as a Path so it needs no particular font and is not an emoji.
/// Filled when subscribed, outline when not.
export component Bell inherits Rectangle {
    in property <bool> on;
    in property <color> tint: Theme.text_mute;
    in property <length> size_px: 15px;

    width: root.size_px;
    height: root.size_px;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 12 2.5 C 8.6 2.5 6.2 5 6.2 8.2 L 6.2 12.4 L 4.3 15.6 L 19.7 15.6 L 17.8 12.4 L 17.8 8.2 C 17.8 5 15.4 2.5 12 2.5 Z M 9.6 17.4 C 9.6 19 10.7 20 12 20 C 13.3 20 14.4 19 14.4 17.4 Z";
        fill: root.on ? root.tint : transparent;
        stroke: root.tint;
        stroke-width: root.on ? 0px : 1.6px;
    }
}

export component Skeleton inherits Rectangle {
    background: Theme.bg_3;
    border-radius: Theme.radius;
    opacity: 0.55;
    animate opacity {
        duration: 1100ms;
        iteration-count: -1;
        direction: alternate;
        easing: ease-in-out;
    }
    init => { self.opacity = 0.9; }
}

export component Thumb inherits Rectangle {
    in property <image> source;
    in property <length> radius: Theme.radius;
    background: Theme.bg_3;
    border-radius: root.radius;
    clip: true;

    Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: cover;
        opacity: root.source.width > 0 ? 1.0 : 0.0;
        animate opacity { duration: Motion.normal; easing: Motion.ease; }
    }
}

export component Avatar inherits Rectangle {
    in property <image> source;
    in property <length> size_px: 32px;
    in property <bool> show_presence: false;
    in property <bool> online: false;

    width: root.size_px;
    height: root.size_px;

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg_3;
        border-radius: Theme.radius;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            source: root.source;
            image-fit: cover;
            opacity: root.source.width > 0 ? 1.0 : 0.0;
            animate opacity { duration: Motion.normal; easing: Motion.ease; }
        }
    }

    if root.show_presence: Rectangle {
        width: root.size_px * 0.3;
        height: self.width;
        x: root.width - self.width + 1px;
        y: root.height - self.height + 1px;
        border-radius: self.width / 2;
        background: root.online ? Theme.accent : Theme.text_mute;
        border-width: 2px;
        border-color: Theme.bg_0;
    }
}

export component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    /// Destructive. Red label and border, filled only on hover — a wall of
    /// solid red buttons reads as an error state rather than a set of choices.
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <length> pad_h: Space.lg;
    callback clicked();

    height: 32px;
    width: txt.preferred-width + root.pad_h * 2;
    border-radius: Theme.radius;
    opacity: root.enabled ? 1.0 : 0.4;

    background: root.danger
        ? (ta.pressed ? Theme.danger
           : ta.has-hover ? Theme.danger.with-alpha(0.18) : Theme.bg_2)
        : root.primary
        ? (!root.enabled ? Theme.accent
           : ta.pressed ? Theme.accent_press
           : ta.has-hover ? Theme.accent_hover : Theme.accent)
        : (ta.pressed ? Theme.bg_4 : ta.has-hover ? Theme.bg_3 : Theme.bg_2);
    animate background { duration: Motion.instant; easing: Motion.ease; }

    border-width: root.primary && !root.danger ? 0px : Theme.hairline;
    border-color: root.danger ? Theme.danger : Theme.line;

    txt := Text {
        text: root.label;
        color: root.danger ? (ta.pressed ? Theme.on_accent : Theme.danger)
               : root.primary ? Theme.on_accent : Theme.text;
        font-size: Type.body;
        font-weight: Type.w_medium;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component IconBtn inherits Rectangle {
    in property <string> glyph;
    in property <bool> active: false;
    in property <length> size_px: 30px;
    callback clicked();

    width: root.size_px;
    height: root.size_px;
    border-radius: Theme.radius;
    background: ta.pressed ? Theme.bg_4 : ta.has-hover ? Theme.bg_3 : transparent;
    animate background { duration: Motion.instant; easing: Motion.ease; }

    Text {
        text: root.glyph;
        color: root.active ? Theme.accent : Theme.text_dim;
        font-size: Type.body;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    height: 28px;
    width: t.preferred-width + Space.md * 2;
    border-radius: Theme.radius;
    background: root.selected ? Theme.accent_soft
                : ta.pressed ? Theme.bg_4
                : ta.has-hover ? Theme.bg_3 : Theme.bg_2;
    border-width: Theme.hairline;
    border-color: root.selected ? Theme.accent : Theme.line;
    animate background, border-color { duration: Motion.instant; easing: Motion.ease; }

    t := Text {
        text: root.label;
        color: root.selected ? Theme.accent : Theme.text_dim;
        font-size: Type.small;
        font-weight: Type.w_medium;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Badge inherits Rectangle {
    in property <int> count;
    height: 17px;
    width: Math.max(17px, bt.preferred-width + 9px);
    border-radius: Theme.radius_pill;
    background: Theme.accent;

    bt := Text {
        text: root.count > 99 ? "99+" : root.count;
        color: Theme.on_accent;
        font-size: Type.micro;
        font-weight: Type.w_bold;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

export component EmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    alignment: center;
    spacing: Space.sm;

    Text {
        text: root.title;
        color: Theme.text_dim;
        font-size: Type.lead;
        font-weight: Type.w_medium;
        horizontal-alignment: center;
    }
    Text {
        text: root.hint;
        color: Theme.text_mute;
        font-size: Type.small;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current: 0;
    callback changed(int);

    height: 32px;
    width: lay.preferred-width;
    background: Theme.bg_2;
    border-radius: Theme.radius;
    border-width: Theme.hairline;
    border-color: Theme.line;

    lay := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for opt[i] in root.options: Rectangle {
            width: ot.preferred-width + Space.lg;
            border-radius: Theme.radius;
            background: root.current == i ? Theme.bg_4
                        : sta.has-hover ? Theme.bg_3 : transparent;
            animate background { duration: Motion.instant; easing: Motion.ease; }

            ot := Text {
                text: opt;
                color: root.current == i ? Theme.text : Theme.text_dim;
                font-size: Type.small;
                font-weight: Type.w_medium;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            sta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.current = i; root.changed(i); }
            }
        }
    }
}

export component MetaStat inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> value;
    spacing: 3px;

    Text {
        text: root.glyph;
        color: Theme.text_mute;
        font-size: Type.caption;
        vertical-alignment: center;
    }
    Text {
        text: root.value;
        color: Theme.text_mute;
        font-size: Type.caption;
        vertical-alignment: center;
    }
}

/// A brief confirmation that floats over the bottom of the window.
///
/// Driven by a monotonically increasing `nonce` rather than a bool: copying
/// twice in a row must replay the animation, and re-assigning the same text
/// would not retrigger it.
export component Toast inherits Rectangle {
    in property <string> text;
    in property <int> nonce: 0;

    property <int> seen: 0;
    property <bool> showing: false;

    changed nonce => {
        if (root.nonce != root.seen) {
            root.seen = root.nonce;
            root.showing = true;
            hide.restart();
        }
    }

    hide := Timer {
        interval: 1400ms;
        running: root.showing;
        triggered() => {
            root.showing = false;
            self.running = false;
        }
    }

    visible: root.opacity > 0.01;
    opacity: root.showing ? 1.0 : 0.0;
    animate opacity { duration: Motion.normal; easing: Motion.ease; }

    height: 34px;
    width: label.preferred-width + Space.xl * 2;
    background: Theme.bg_4;
    border-radius: Theme.radius;
    border-width: Theme.hairline;
    border-color: Theme.line_strong;

    label := Text {
        text: root.text;
        color: Theme.text;
        font-size: Type.body;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

/// A barely-there diagonal hatch for large empty areas.
///
/// Tiled from an 8x8 source whose line wraps on both axes, so it repeats
/// seamlessly at any size. Colorised from the text token rather than baked in,
/// which keeps it correct when the theme flips to light.
export component Texture inherits Image {
    source: @image-url("texture.png");
    horizontal-tiling: repeat;
    vertical-tiling: repeat;
    colorize: Theme.text;
    opacity: 0.035;
}

/// A modal confirmation.
///
/// Exists because `confirm_destructive` was a setting nothing read — the toggle
/// was there and every destructive action went ahead regardless. One dialog
/// driven by root state serves all of them rather than each growing its own.
export component ConfirmDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> title;
    in property <string> body;
    in property <string> action_label: "Confirm";
    in property <bool> danger: false;
    callback accept();
    callback cancel();

    visible: root.open;
    background: #000000AA;

    // Swallow anything aimed at the page behind, and offer the usual
    // click-outside-to-dismiss.
    TouchArea { clicked => { root.cancel(); } }

    if root.open: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(430px, parent.width - Space.xl * 2);
        height: lay.preferred-height;
        background: Theme.bg_1;
        border-radius: Theme.radius;
        border-width: Theme.hairline;
        border-color: root.danger ? Theme.danger : Theme.line_strong;

        opacity: 0;
        animate opacity { duration: Motion.fast; easing: Motion.ease; }
        init => { self.opacity = 1.0; }

        TouchArea {}

        lay := VerticalLayout {
            padding: Space.lg;
            spacing: Space.md;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: Type.body;
                font-weight: Type.w_bold;
                wrap: word-wrap;
            }
            Text {
                text: root.body;
                color: Theme.text_mute;
                font-size: Type.caption;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Space.sm;
                Rectangle { horizontal-stretch: 1; }
                Btn {
                    label: "Cancel";
                    clicked => { root.cancel(); }
                }
                Btn {
                    label: root.action_label;
                    danger: root.danger;
                    primary: !root.danger;
                    clicked => { root.accept(); }
                }
            }
        }
    }
}
