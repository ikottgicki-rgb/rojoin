import { Theme, Space, Type, Motion, Layout } from "theme.slint";
import { Avatar, Btn, IconBtn, Chip, Badge, Spinner, BusySlot, Bell, EmptyState, MetaStat, Texture } from "components.slint";
import { FriendRow, DetailItem, RequestRow } from "types.slint";
import { ListView } from "std-widgets.slint";

component PresenceDot inherits Rectangle {
    in property <int> presence;
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background: root.presence == 2 ? Theme.accent
                : root.presence == 1 ? Theme.text_dim
                : root.presence == 3 ? Theme.warn
                : Theme.text_mute;
    opacity: root.presence == 0 ? 0.45 : 1.0;
}

component FriendListRow inherits Rectangle {
    in property <FriendRow> entry;
    callback open();
    callback join();
    callback pin();
    callback notify();
    callback toggle_group();
    callback context_menu(length, length);

    height: root.entry.is_header ? 34px : 56px;

    if root.entry.is_header: Rectangle {
        width: 100%;
        height: 100%;
        HorizontalLayout {
            padding-left: Space.lg;
            padding-right: Space.lg;
            spacing: Space.sm;

            VerticalLayout {
                alignment: center;
                Text {
                    text: root.entry.header_label;
                    color: Theme.text_mute;
                    font-size: Type.caption;
                    font-weight: Type.w_bold;
                    letter-spacing: 0.6px;
                }
            }
            if root.entry.collapsible: VerticalLayout {
                alignment: center;
                Text {
                    text: root.entry.collapsed ? "▸" : "▾";
                    color: Theme.text_mute;
                    font-size: Type.micro;
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.entry.collapsible: TouchArea {
            mouse-cursor: pointer;
            clicked => { root.toggle_group(); }
        }
    }

    if !root.entry.is_header: Rectangle {
        width: 100%;
        height: 100%;
        background: fta.has-hover ? Theme.bg_2 : transparent;
        animate background { duration: Motion.instant; easing: Motion.ease; }

        fta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open(); }
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                    root.context_menu(
                        self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y
                    );
                }
            }
        }

        HorizontalLayout {
            padding-left: Space.lg;
            padding-right: Space.lg;
            spacing: Space.md;

            VerticalLayout {
                alignment: center;
                Avatar {
                    source: root.entry.avatar;
                    size_px: 36px;
                    show_presence: true;
                    online: root.entry.presence != 0;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                HorizontalLayout {
                    spacing: Space.sm;
                    alignment: start;
                    Text {
                        text: root.entry.name;
                        color: Theme.text;
                        font-size: Type.body;
                        font-weight: Type.w_medium;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "@" + root.entry.username;
                            color: Theme.text_mute;
                            font-size: Type.caption;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: Space.xs;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        PresenceDot { presence: root.entry.presence; }
                    }
                    Text {
                        text: root.entry.subtitle;
                        color: root.entry.presence == 2 ? Theme.text_dim : Theme.text_mute;
                        font-size: Type.caption;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: Space.xxs;

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        Text {
                            text: root.entry.pinned ? "★" : "☆";
                            color: root.entry.pinned ? Theme.accent
                                   : pinta.has-hover ? Theme.text : Theme.text_mute;
                            font-size: Type.body;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            animate color { duration: Motion.fast; easing: Motion.ease; }
                        }
                        pinta := TouchArea { mouse-cursor: pointer; clicked => { root.pin(); } }
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        Bell {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            on: root.entry.notify;
                            tint: root.entry.notify ? Theme.accent
                                  : notta.has-hover ? Theme.text : Theme.text_mute;
                        }
                        notta := TouchArea { mouse-cursor: pointer; clicked => { root.notify(); } }
                    }

                    Rectangle {
                        width: 60px;
                        height: 28px;

                        if root.entry.joinable: Rectangle {
                            width: 100%;
                            height: 100%;
                            background: jta.pressed ? Theme.accent_press
                                        : jta.has-hover ? Theme.accent_hover : Theme.accent;
                            border-radius: Theme.radius;
                            animate background { duration: Motion.instant; easing: Motion.ease; }
                            Text {
                                text: "Join";
                                color: Theme.on_accent;
                                font-size: Type.small;
                                font-weight: Type.w_bold;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                            jta := TouchArea { mouse-cursor: pointer; clicked => { root.join(); } }
                        }
                    }
                }
            }
        }

    }
}

export component FriendsScreen inherits Rectangle {
    in property <[FriendRow]> rows;
    in property <[RequestRow]> requests;
    /// Is the requests panel showing?
    in-out property <bool> requests_open: false;
    in property <bool> loading: false;
    in property <int> in_game: 0;
    in property <int> online: 0;
    in-out property <string> filter;
    in property <string> request_status;

    callback refresh();
    callback filter_changed(string);
    callback open_request(string);
    callback toggle_requests();
    callback open(string);
    callback join(string);
    callback pin(string);
    callback notify(string);
    callback toggle_group(string);
    callback accept(string);
    callback decline(string);
    callback context_menu(string, length, length);

    background: Theme.bg_0;

    Texture { width: 100%; height: 100%; }

    VerticalLayout {
        spacing: 0;

        Rectangle {
            height: 56px;
            background: Theme.bg_1;
            HorizontalLayout {
                padding-left: Space.lg;
                padding-right: Space.lg;
                spacing: Space.md;

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: "Friends";
                        color: Theme.text;
                        font-size: Type.title;
                        font-weight: Type.w_bold;
                    }
                    Text {
                        text: root.in_game + " in game · " + root.online + " online";
                        color: Theme.text_mute;
                        font-size: Type.caption;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 220px;
                        height: 30px;
                        background: Theme.bg_2;
                        border-radius: Theme.radius;
                        border-width: Theme.hairline;
                        border-color: ffield.has-focus ? Theme.accent : Theme.line;
                        animate border-color { duration: Motion.fast; easing: Motion.ease; }

                        HorizontalLayout {
                            padding-left: Space.sm;
                            padding-right: Space.xs;
                            spacing: Space.xs;
                            Rectangle {
                                horizontal-stretch: 1;
                                ffield := TextInput {
                                    width: 100%;
                                    height: 100%;
                                    text <=> root.filter;
                                    color: Theme.text;
                                    font-size: Type.small;
                                    vertical-alignment: center;
                                    single-line: true;
                                    edited => { root.filter_changed(self.text); }
                                }
                                if root.filter == "": Text {
                                    x: 0;
                                    width: 100%;
                                    height: 100%;
                                    text: "Filter";
                                    color: Theme.text_mute;
                                    font-size: Type.small;
                                    vertical-alignment: center;
                                    horizontal-alignment: left;
                                }
                            }
                            if root.filter != "": VerticalLayout {
                                alignment: center;
                                IconBtn {
                                    glyph: "×";
                                    size_px: 22px;
                                    clicked => { root.filter = ""; root.filter_changed(""); }
                                }
                            }
                        }
                    }
                }

                // Requests live behind this rather than in a bar across the
                // top: they are occasional, and a permanent strip spends the
                // screen's most valuable row on something usually empty.
                if root.requests.length > 0: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        IconBtn {
                            glyph: "✉";
                            size_px: 30px;
                            active: root.requests_open;
                            clicked => { root.toggle_requests(); }
                        }
                        Badge {
                            x: parent.width - self.width + 5px;
                            y: -4px;
                            count: root.requests.length;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    BusySlot {
                        busy: root.loading;
                        IconBtn { glyph: "⟳"; clicked => { root.refresh(); } }
                    }
                }
            }
        }
        Rectangle { height: Theme.hairline; background: Theme.line; }


        if !root.loading && root.rows.length == 0: EmptyState {
            vertical-stretch: 1;
            title: root.filter != "" ? "No friends match \"" + root.filter + "\"" : "No friends yet";
            hint: root.filter != "" ? "Try a different name." : "Add someone on Roblox and they will show up here.";
        }

        if root.rows.length > 0: ListView {
            vertical-stretch: 1;
            for r in root.rows: FriendListRow {
                entry: r;
                open => { root.open(r.id); }
                join => { root.join(r.id); }
                pin => { root.pin(r.id); }
                notify => { root.notify(r.id); }
                toggle_group => { root.toggle_group(r.header_label); }
                context_menu(mx, my) => { root.context_menu(r.id, mx, my); }
            }
        }
    }
        // The requests panel. A later sibling than the content, so it draws
        // over it; the scrim underneath both dims the list and gives an
        // anywhere-click way out.
        if root.requests_open: Rectangle {
            background: #00000099;
            opacity: 0;
            animate opacity { duration: Motion.fast; easing: Motion.ease; }
            init => { self.opacity = 1.0; }

            TouchArea { clicked => { root.toggle_requests(); } }

            Rectangle {
                x: parent.width - self.width - Space.lg;
                y: Space.lg;
                width: min(420px, parent.width - Space.lg * 2);
                // Sized from the row count, not from the ListView: a ListView is
                // a scrolling viewport and reports no useful preferred height,
                // so asking it collapsed the panel to a single row.
                height: min(38px + root.requests.length * 66px + Space.md * 2,
                            parent.height - Space.lg * 2);
                background: Theme.bg_1;
                border-radius: Theme.radius;
                border-width: Theme.hairline;
                border-color: Theme.line_strong;

                // Fades in. Cheap, and it stops the panel from snapping into
                // existence.
                opacity: 0;
                animate opacity { duration: Motion.normal; easing: Motion.ease; }
                init => { self.opacity = 1.0; }

                // Swallow clicks so they do not reach the dismiss scrim.
                TouchArea {}

                VerticalLayout {
                    padding: Space.md;
                    spacing: Space.sm;

                    head := HorizontalLayout {
                        spacing: Space.sm;
                        Text {
                            text: "Friend requests";
                            color: Theme.text;
                            font-size: Type.small;
                            font-weight: Type.w_bold;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            Badge { count: root.requests.length; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        IconBtn {
                            glyph: "×";
                            size_px: 26px;
                            clicked => { root.toggle_requests(); }
                        }
                    }

                    if root.request_status != "": Text {
                        text: root.request_status;
                        color: Theme.warn;
                        font-size: Type.caption;
                        wrap: word-wrap;
                    }

                    list := ListView {
                        vertical-stretch: 1;
                        for r in root.requests: Rectangle {
                            height: 66px;
                            background: rta.has-hover ? Theme.bg_2 : transparent;
                            border-radius: Theme.radius;
                            animate background { duration: Motion.instant; easing: Motion.ease; }

                            rta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open_request(r.id); }
                            }

                            HorizontalLayout {
                                padding: Space.sm;
                                spacing: Space.sm;

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 38px;
                                        height: 38px;
                                        Avatar { source: r.thumb; size_px: 38px; }
                                        PresenceDot {
                                            x: parent.width - self.width;
                                            y: parent.height - self.height;
                                            presence: r.presence;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 1px;

                                    HorizontalLayout {
                                        spacing: Space.xs;
                                        Text {
                                            text: r.name;
                                            color: Theme.text;
                                            font-size: Type.small;
                                            font-weight: Type.w_medium;
                                            overflow: elide;
                                            wrap: no-wrap;
                                        }
                                        Text {
                                            text: "@" + r.username;
                                            color: Theme.text_mute;
                                            font-size: Type.caption;
                                            overflow: elide;
                                            wrap: no-wrap;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    Text {
                                        text: r.description != "" ? r.description
                                              : (r.presence_label != "" ? r.presence_label
                                                                        : "No description.");
                                        color: Theme.text_mute;
                                        font-size: Type.caption;
                                        overflow: elide;
                                        wrap: no-wrap;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: "›";
                                        color: Theme.text_mute;
                                        font-size: Type.body;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

}
