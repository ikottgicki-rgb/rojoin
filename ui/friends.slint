import { Theme, Space, Type, Motion, Layout } from "theme.slint";
import { Avatar, Btn, IconBtn, Chip, Badge, Spinner, EmptyState, MetaStat } from "components.slint";
import { FriendRow, DetailItem } from "types.slint";
import { ListView } from "std-widgets.slint";

// Friends.
//
// Ordering answers "who can I join right now": in-game first, then online,
// then everyone else. Pinned friends are lifted into their own section at the
// very top regardless of presence, and removed from the groups below so
// nobody appears twice.

component PresenceDot inherits Rectangle {
    in property <int> presence;
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background: root.presence == 2 ? Theme.accent
                : root.presence == 1 ? Theme.text_dim
                : root.presence == 3 ? Theme.warn
                : Theme.text_mute;
    opacity: root.presence == 0 ? 0.45 : 1.0;
}

component FriendListRow inherits Rectangle {
    in property <FriendRow> entry;
    callback open();
    callback join();
    callback pin();
    callback notify();
    callback toggle_group();
    callback context_menu(length, length);

    height: root.entry.is_header ? 34px : 56px;

    // --- group header ---------------------------------------------------
    if root.entry.is_header: Rectangle {
        width: 100%;
        height: 100%;
        HorizontalLayout {
            padding-left: Space.lg;
            padding-right: Space.lg;
            spacing: Space.sm;

            VerticalLayout {
                alignment: center;
                Text {
                    text: root.entry.header_label;
                    color: Theme.text_mute;
                    font-size: Type.caption;
                    font-weight: Type.w_bold;
                    letter-spacing: 0.6px;
                }
            }
            if root.entry.collapsible: VerticalLayout {
                alignment: center;
                Text {
                    text: root.entry.collapsed ? "▸" : "▾";
                    color: Theme.text_mute;
                    font-size: Type.micro;
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.entry.collapsible: TouchArea {
            mouse-cursor: pointer;
            clicked => { root.toggle_group(); }
        }
    }

    // --- friend ----------------------------------------------------------
    if !root.entry.is_header: Rectangle {
        width: 100%;
        height: 100%;
        background: fta.has-hover ? Theme.bg_2 : transparent;
        animate background { duration: Motion.instant; easing: Motion.ease; }

        HorizontalLayout {
            padding-left: Space.lg;
            padding-right: Space.lg;
            spacing: Space.md;

            VerticalLayout {
                alignment: center;
                Avatar {
                    source: root.entry.avatar;
                    size_px: 36px;
                    show_presence: true;
                    online: root.entry.presence != 0;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                HorizontalLayout {
                    spacing: Space.sm;
                    alignment: start;
                    Text {
                        text: root.entry.name;
                        color: Theme.text;
                        font-size: Type.body;
                        font-weight: Type.w_medium;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "@" + root.entry.username;
                            color: Theme.text_mute;
                            font-size: Type.caption;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: Space.xs;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        PresenceDot { presence: root.entry.presence; }
                    }
                    Text {
                        text: root.entry.subtitle;
                        color: root.entry.presence == 2 ? Theme.text_dim : Theme.text_mute;
                        font-size: Type.caption;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: Space.xxs;

                    // Pin and bell stay visible when active, so their state is
                    // readable without hovering every row.
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        opacity: fta.has-hover || root.entry.pinned ? 1.0 : 0.0;
                        animate opacity { duration: Motion.fast; easing: Motion.ease; }
                        Text {
                            text: root.entry.pinned ? "★" : "☆";
                            color: root.entry.pinned ? Theme.accent : Theme.text_dim;
                            font-size: Type.body;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { root.pin(); } }
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        opacity: fta.has-hover || root.entry.notify ? 1.0 : 0.0;
                        animate opacity { duration: Motion.fast; easing: Motion.ease; }
                        Text {
                            text: root.entry.notify ? "◉" : "○";
                            color: root.entry.notify ? Theme.accent : Theme.text_dim;
                            font-size: Type.body;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { root.notify(); } }
                    }

                    // The slot is always reserved, so the star and bell keep
                    // the same x whether or not a friend is joinable.
                    Rectangle {
                        width: 60px;
                        height: 28px;

                        if root.entry.joinable: Rectangle {
                            width: 100%;
                            height: 100%;
                            background: jta.pressed ? Theme.accent_press
                                        : jta.has-hover ? Theme.accent_hover : Theme.accent;
                            border-radius: Theme.radius;
                            animate background { duration: Motion.instant; easing: Motion.ease; }
                            Text {
                                text: "Join";
                                color: Theme.on_accent;
                                font-size: Type.small;
                                font-weight: Type.w_bold;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                            jta := TouchArea { mouse-cursor: pointer; clicked => { root.join(); } }
                        }
                    }
                }
            }
        }

        fta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open(); }
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                    root.context_menu(
                        self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y
                    );
                }
            }
        }
    }
}

export component FriendsScreen inherits Rectangle {
    in property <[FriendRow]> rows;
    in property <[DetailItem]> requests;
    in property <bool> loading: false;
    in property <int> in_game: 0;
    in property <int> online: 0;
    in-out property <string> filter;

    callback refresh();
    callback filter_changed(string);
    callback open(string);
    callback join(string);
    callback pin(string);
    callback notify(string);
    callback toggle_group(string);
    callback accept(string);
    callback decline(string);
    callback context_menu(string, length, length);

    background: Theme.bg_0;

    VerticalLayout {
        spacing: 0;

        // --- header ------------------------------------------------------
        Rectangle {
            height: 56px;
            background: Theme.bg_1;
            HorizontalLayout {
                padding-left: Space.lg;
                padding-right: Space.lg;
                spacing: Space.md;

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: "Friends";
                        color: Theme.text;
                        font-size: Type.title;
                        font-weight: Type.w_bold;
                    }
                    Text {
                        text: root.in_game + " in game · " + root.online + " online";
                        color: Theme.text_mute;
                        font-size: Type.caption;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 220px;
                        height: 30px;
                        background: Theme.bg_2;
                        border-radius: Theme.radius;
                        border-width: Theme.hairline;
                        border-color: ffield.has-focus ? Theme.accent : Theme.line;
                        animate border-color { duration: Motion.fast; easing: Motion.ease; }

                        HorizontalLayout {
                            padding-left: Space.sm;
                            padding-right: Space.xs;
                            spacing: Space.xs;
                            Rectangle {
                                horizontal-stretch: 1;
                                ffield := TextInput {
                                    width: 100%;
                                    height: 100%;
                                    text <=> root.filter;
                                    color: Theme.text;
                                    font-size: Type.small;
                                    vertical-alignment: center;
                                    single-line: true;
                                    edited => { root.filter_changed(self.text); }
                                }
                                if root.filter == "": Text {
                                    x: 0;
                                    width: 100%;
                                    height: 100%;
                                    text: "Filter friends";
                                    color: Theme.text_mute;
                                    font-size: Type.small;
                                    vertical-alignment: center;
                                    horizontal-alignment: left;
                                }
                            }
                            if root.filter != "": VerticalLayout {
                                alignment: center;
                                IconBtn {
                                    glyph: "×";
                                    size_px: 22px;
                                    clicked => { root.filter = ""; root.filter_changed(""); }
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    if root.loading: Spinner { size_px: 14px; }
                    if !root.loading: IconBtn { glyph: "⟳"; clicked => { root.refresh(); } }
                }
            }
        }
        Rectangle { height: Theme.hairline; background: Theme.line; }

        // --- pending requests --------------------------------------------
        if root.requests.length > 0 && root.filter == "": Rectangle {
            height: 92px;
            background: Theme.bg_1;
            VerticalLayout {
                padding: Space.md;
                spacing: Space.sm;

                HorizontalLayout {
                    spacing: Space.sm;
                    Text {
                        text: "Friend requests";
                        color: Theme.text_dim;
                        font-size: Type.caption;
                        font-weight: Type.w_bold;
                        letter-spacing: 0.6px;
                    }
                    VerticalLayout {
                        alignment: center;
                        Badge { count: root.requests.length; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                HorizontalLayout {
                    spacing: Space.sm;
                    alignment: start;
                    for r in root.requests: Rectangle {
                        width: 210px;
                        height: 40px;
                        background: Theme.bg_2;
                        border-radius: Theme.radius;
                        border-width: Theme.hairline;
                        border-color: Theme.line;

                        HorizontalLayout {
                            padding-left: Space.sm;
                            padding-right: Space.xs;
                            spacing: Space.sm;

                            VerticalLayout {
                                alignment: center;
                                Avatar { source: r.thumb; size_px: 26px; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: r.name;
                                    color: Theme.text;
                                    font-size: Type.small;
                                    overflow: elide;
                                    wrap: no-wrap;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    spacing: Space.xxs;
                                    IconBtn { glyph: "✓"; size_px: 24px; clicked => { root.accept(r.id); } }
                                    IconBtn { glyph: "×"; size_px: 24px; clicked => { root.decline(r.id); } }
                                }
                            }
                        }
                    }
                }
            }
        }

        // --- list ---------------------------------------------------------
        if !root.loading && root.rows.length == 0: EmptyState {
            vertical-stretch: 1;
            title: root.filter != "" ? "No friends match \"" + root.filter + "\"" : "No friends yet";
            hint: root.filter != "" ? "Try a different name." : "Add someone on Roblox and they will show up here.";
        }

        if root.rows.length > 0: ListView {
            vertical-stretch: 1;
            for r in root.rows: FriendListRow {
                entry: r;
                open => { root.open(r.id); }
                join => { root.join(r.id); }
                pin => { root.pin(r.id); }
                notify => { root.notify(r.id); }
                toggle_group => { root.toggle_group(r.header_label); }
                context_menu(mx, my) => { root.context_menu(r.id, mx, my); }
            }
        }
    }
}
