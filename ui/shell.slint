import { Theme, Space, Type, Motion, Layout } from "theme.slint";
import { Btn, IconBtn, Badge, Avatar, Spinner, BusySlot } from "components.slint";

// The navigation shell: sidebar, top bar, and the sliding active-item pill.
// Screens plug into the content host in app.slint.

export struct NavEntry {
    id: int,
    label: string,
    glyph: string,
    badge: int,
}

component NavItem inherits Rectangle {
    in property <NavEntry> entry;
    in property <bool> active;
    callback clicked();

    height: 36px;

    // No background of its own — the sliding pill in Sidebar draws it, so the
    // highlight animates between items instead of blinking on and off.
    Rectangle {
        width: 100%;
        height: 100%;
        background: !root.active && ta.has-hover ? Theme.bg_2 : transparent;
        animate background { duration: Motion.instant; easing: Motion.ease; }
    }

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.md;

        VerticalLayout {
            alignment: center;
            Text {
                text: root.entry.glyph;
                color: root.active ? Theme.text : Theme.text_mute;
                font-size: Type.body;
                width: 16px;
                horizontal-alignment: center;
                animate color { duration: Motion.fast; easing: Motion.ease; }
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: root.entry.label;
                color: root.active ? Theme.text : Theme.text_dim;
                font-size: Type.body;
                font-weight: root.active ? Type.w_medium : Type.w_regular;
                animate color { duration: Motion.fast; easing: Motion.ease; }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        if root.entry.badge > 0: VerticalLayout {
            alignment: center;
            Badge { count: root.entry.badge; }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Sidebar inherits Rectangle {
    in property <[NavEntry]> entries;
    in property <int> active;
    in property <string> app_version;
    callback navigate(int);
    callback open_settings();

    width: Layout.sidebar_w;
    background: Theme.bg_1;

    VerticalLayout {
        padding-top: Space.sm;
        padding-bottom: Space.sm;
        spacing: 0;

        Rectangle {
            vertical-stretch: 1;

            // The sliding pill. One rectangle that animates to the active row,
            // rather than each row toggling its own background.
            if root.active >= 0: Rectangle {
                x: Space.sm;
                y: root.active * 36px;
                width: parent.width - Space.sm * 2;
                height: 36px;
                background: Theme.bg_3;
                border-radius: Theme.radius;
                animate y { duration: Motion.normal; easing: Motion.ease; }

                // Accent edge marks the active section.
                Rectangle {
                    x: 0;
                    width: 2px;
                    height: 100%;
                    background: Theme.accent;
                }
            }

            VerticalLayout {
                alignment: start;
                padding-left: Space.sm;
                padding-right: Space.sm;
                spacing: 0;

                for e[i] in root.entries: NavItem {
                    entry: e;
                    active: root.active == i;
                    clicked => { root.navigate(i); }
                }
            }
        }

        Rectangle { height: Theme.hairline; background: Theme.line; }

        HorizontalLayout {
            padding: Space.sm;
            spacing: Space.sm;

            VerticalLayout {
                alignment: center;
                Text {
                    text: "v" + root.app_version;
                    color: Theme.text_mute;
                    font-size: Type.micro;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            IconBtn {
                glyph: "⚙";
                clicked => { root.open_settings(); }
            }
        }
    }
}

export component TopBar inherits Rectangle {
    in property <bool> can_back;
    in property <bool> busy;
    in property <string> account_name;
    in property <image> account_avatar;
    in-out property <string> query;

    callback back();
    callback submit(string);
    callback open_account();
    callback live_search(string);

    public function focus_search() {
        search.focus();
    }

    height: Layout.topbar_h;
    background: Theme.bg_1;

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.md;

        VerticalLayout {
            alignment: center;
            IconBtn {
                glyph: "←";
                size_px: 30px;
                clicked => { root.back(); }
                // Kept mounted but inert so the search field never shifts
                // sideways as you navigate.
                opacity: root.can_back ? 1.0 : 0.0;
                animate opacity { duration: Motion.fast; easing: Motion.ease; }
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 32px;
                width: 420px;
                background: Theme.bg_2;
                border-radius: Theme.radius;
                border-width: Theme.hairline;
                border-color: search.has-focus ? Theme.accent : Theme.line;
                animate border-color { duration: Motion.fast; easing: Motion.ease; }

                HorizontalLayout {
                    padding-left: Space.sm;
                    padding-right: Space.xs;
                    spacing: Space.sm;

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "⌕";
                            color: Theme.text_mute;
                            font-size: Type.lead;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        search := TextInput {
                            width: 100%;
                            height: 100%;
                            text <=> root.query;
                            color: Theme.text;
                            font-size: Type.body;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => { root.submit(self.text); }
                            edited => { root.live_search(self.text); }
                        }
                        // x/width are explicit: a Text placed directly in a
                        // Rectangle is centred by default, which makes a
                        // placeholder sit in the middle of the field.
                        if root.query == "": Text {
                            x: 0;
                            width: 100%;
                            height: 100%;
                            text: "Search games, people, groups";
                            color: Theme.text_mute;
                            font-size: Type.body;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                        }
                    }

                    if root.query != "": VerticalLayout {
                        alignment: center;
                        IconBtn {
                            glyph: "×";
                            size_px: 24px;
                            clicked => { root.query = ""; root.live_search(""); }
                        }
                    }
                }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        VerticalLayout {
            alignment: center;
            BusySlot { busy: root.busy; slot: 20px; Rectangle {} }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 34px;
                width: acct.preferred-width + Space.sm * 2 + 26px;
                border-radius: Theme.radius;
                background: ata.pressed ? Theme.bg_4 : ata.has-hover ? Theme.bg_3 : transparent;
                animate background { duration: Motion.instant; easing: Motion.ease; }

                HorizontalLayout {
                    padding-left: Space.sm;
                    padding-right: Space.sm;
                    spacing: Space.sm;

                    VerticalLayout {
                        alignment: center;
                        Avatar { source: root.account_avatar; size_px: 22px; }
                    }
                    VerticalLayout {
                        alignment: center;
                        acct := Text {
                            text: root.account_name;
                            color: Theme.text;
                            font-size: Type.small;
                            font-weight: Type.w_medium;
                        }
                    }
                }

                ata := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open_account(); }
                }
            }
        }
    }
}

/// Shown when a stored cookie stops working. Deliberately a banner, not a
/// toast: an expired session is a persistent state the user must act on, and a
/// toast that disappears after three seconds is the wrong shape for that.
export component ExpiredBanner inherits Rectangle {
    callback sign_in();
    callback dismiss();

    height: 38px;
    background: Theme.accent_soft;

    HorizontalLayout {
        padding-left: Space.lg;
        padding-right: Space.sm;
        spacing: Space.md;

        VerticalLayout {
            alignment: center;
            Text {
                text: "Your session expired. Sign in again to keep using RoJoin.";
                color: Theme.text;
                font-size: Type.small;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            Btn {
                label: "Sign in";
                primary: true;
                clicked => { root.sign_in(); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconBtn { glyph: "×"; clicked => { root.dismiss(); } }
        }
    }
}
