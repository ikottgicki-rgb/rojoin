import { Theme, Space, Type, Motion, Layout } from "theme.slint";
import { Thumb, Avatar, Btn, IconBtn, Chip, Badge, Skeleton, EmptyState, Spinner, BusySlot, MetaStat, Segmented, Texture } from "components.slint";
import { GameGrid, GameListRow, ItemGrid } from "cards.slint";
import { GameTile, DetailItem } from "types.slint";
import { PlaytimeGraph, GraphSegment, GraphDay, GraphLegend } from "graph.slint";
import { ScrollView } from "std-widgets.slint";

component SectionHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> count_label;
    spacing: Space.sm;

    Text {
        text: root.title;
        color: Theme.text;
        font-size: Type.title;
        font-weight: Type.w_bold;
    }
    if root.count_label != "": VerticalLayout {
        alignment: center;
        Text {
            text: root.count_label;
            color: Theme.text_mute;
            font-size: Type.small;
        }
    }
    Rectangle { horizontal-stretch: 1; }
}

export component HomeScreen inherits Rectangle {
    in property <string> greeting;
    in property <string> date_label;
    in property <bool> loading: false;
    in property <bool> launching: false;

    in property <GameTile> hero;
    in property <bool> has_hero: false;
    in property <[GameTile]> recent;
    in property <[GameTile]> favorites;
    in property <[GameTile]> pinned;
    in property <int> friends_online: 0;
    in property <int> friend_requests: 0;
    in property <bool> show_friends: true;
    in property <bool> show_hero: true;
    in property <bool> show_pinned: true;
    in property <bool> show_recent: true;
    in property <bool> show_favorites: true;

    in property <bool> show_graph: true;
    in property <[GraphSegment]> graph_segments;
    in property <[GraphDay]> graph_days;
    in property <[GraphLegend]> graph_legend;
    in property <string> graph_ceiling;
    in property <string> graph_total;
    in property <string> graph_range;
    in property <bool> graph_empty: false;
    in property <[string]> graph_ranges: ["All time"];
    in-out property <int> graph_range_index: 0;
    callback graph_range_changed(int);

    callback open(string);
    callback play(string);
    callback favorite(string);
    callback play_hero();
    callback go_friends();
    callback go_play();
    callback unpin(string);
    callback remove_recent(string);

    background: Theme.bg_0;

    Texture { width: 100%; height: 100%; }

    ScrollView {
        VerticalLayout {
            alignment: start;
            padding: Space.xl;
            spacing: Space.xl;

            VerticalLayout {
                spacing: Space.xxs;
                Text {
                    text: root.greeting;
                    color: Theme.text;
                    font-size: Type.display;
                    font-weight: Type.w_bold;
                }
                Text {
                    text: root.date_label;
                    color: Theme.text_mute;
                    font-size: Type.small;
                }
            }

            if root.show_graph: Rectangle {
                height: 232px;
                background: Theme.bg_1;
                border-radius: Theme.radius;
                border-width: Theme.hairline;
                border-color: Theme.line;

                PlaytimeGraph {
                    x: Space.lg;
                    y: Space.md;
                    width: parent.width - Space.lg * 2;
                    height: parent.height - Space.md * 2;
                    segments: root.graph_segments;
                    days: root.graph_days;
                    legend: root.graph_legend;
                    ceiling_label: root.graph_ceiling;
                    total_label: root.graph_total;
                    range_label: root.graph_range;
                    empty: root.graph_empty;
                    ranges: root.graph_ranges;
                    range_index <=> root.graph_range_index;
                    range_changed(i) => { root.graph_range_changed(i); }
                }
            }

            if root.show_friends: HorizontalLayout {
                spacing: Space.md;
                alignment: start;

                Rectangle {
                    width: 190px;
                    height: 62px;
                    background: fta.has-hover ? Theme.bg_3 : Theme.bg_2;
                    border-radius: Theme.radius;
                    border-width: Theme.hairline;
                    border-color: Theme.line;
                    animate background { duration: Motion.fast; easing: Motion.ease; }

                    HorizontalLayout {
                        padding: Space.md;
                        spacing: Space.sm;
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: root.friends_online + "";
                                color: root.friends_online > 0 ? Theme.accent : Theme.text_dim;
                                font-size: Type.title;
                                font-weight: Type.w_bold;
                            }
                            Text {
                                text: "friends online";
                                color: Theme.text_mute;
                                font-size: Type.caption;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.friend_requests > 0: VerticalLayout {
                            alignment: center;
                            Badge { count: root.friend_requests; }
                        }
                    }
                    fta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.go_friends(); }
                    }
                }
            }

            if root.show_hero && root.has_hero: VerticalLayout {
                spacing: Space.md;
                SectionHead { title: "Jump back in"; }

                Rectangle {
                    height: 168px;
                    background: Theme.bg_2;
                    border-radius: Theme.radius;
                    border-width: Theme.hairline;
                    border-color: Theme.line;
                    clip: true;

                    HorizontalLayout {
                        spacing: 0;
                        Rectangle {
                            width: 298px;
                            Thumb { width: 100%; height: 100%; source: root.hero.thumb; radius: 0px; }
                        }
                        VerticalLayout {
                            padding: Space.lg;
                            spacing: Space.sm;
                            alignment: center;

                            Text {
                                text: root.hero.name;
                                color: Theme.text;
                                font-size: Type.title;
                                font-weight: Type.w_bold;
                                overflow: elide;
                                wrap: no-wrap;
                            }
                            Text {
                                text: root.hero.creator;
                                color: Theme.text_mute;
                                font-size: Type.small;
                            }
                            HorizontalLayout {
                                spacing: Space.lg;
                                alignment: start;
                                MetaStat { glyph: "●"; value: root.hero.playing; }
                                if root.hero.rating >= 0: MetaStat {
                                    glyph: "▲";
                                    value: root.hero.rating + "%";
                                }
                            }
                            HorizontalLayout {
                                spacing: Space.sm;
                                alignment: start;
                                Rectangle {
                                    width: 116px;
                                    height: 34px;
                                    background: root.launching ? Theme.bg_4
                                                : hta.pressed ? Theme.accent_press
                                                : hta.has-hover ? Theme.accent_hover : Theme.accent;
                                    border-radius: Theme.radius;
                                    animate background { duration: Motion.instant; easing: Motion.ease; }
                                    Text {
                                        text: root.launching ? "Launching…" : "Play";
                                        color: root.launching ? Theme.text_dim : Theme.on_accent;
                                        font-size: Type.body;
                                        font-weight: Type.w_bold;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                    hta := TouchArea {
                                        enabled: !root.launching;
                                        mouse-cursor: pointer;
                                        clicked => { root.play_hero(); }
                                    }
                                }
                                Btn {
                                    label: "Details";
                                    clicked => { root.open(root.hero.id); }
                                }
                            }
                        }
                    }
                }
            }

            if root.show_pinned && root.pinned.length > 0: VerticalLayout {
                spacing: Space.md;
                SectionHead { title: "Pinned"; count_label: root.pinned.length + ""; }
                GameGrid {
                    games: root.pinned;
                    open(id) => { root.open(id); }
                    play(id) => { root.play(id); }
                    favorite(id) => { root.unpin(id); }
                }
            }

            if root.show_recent && (root.recent.length > 0 || root.loading): VerticalLayout {
                spacing: Space.md;
                SectionHead { title: "Recently played"; }
                GameGrid {
                    games: root.recent;
                    loading: root.loading;
                    open(id) => { root.open(id); }
                    play(id) => { root.play(id); }
                    favorite(id) => { root.favorite(id); }
                    // Only here: this is the one row a tile can be removed from.
                    removable: true;
                    remove(universe) => { root.remove_recent(universe); }
                }
            }

            if root.show_favorites && root.favorites.length > 0: VerticalLayout {
                spacing: Space.md;
                SectionHead {
                    title: "Favourites";
                    count_label: root.favorites.length + "";
                }
                GameGrid {
                    games: root.favorites;
                    open(id) => { root.open(id); }
                    play(id) => { root.play(id); }
                    favorite(id) => { root.favorite(id); }
                }
            }

            if !root.loading && !root.has_hero && root.recent.length == 0 && root.favorites.length == 0:
            Rectangle {
                height: 230px;
                VerticalLayout {
                    alignment: center;
                    spacing: Space.lg;
                    EmptyState {
                        title: "Nothing played yet";
                        hint: "Find a game and it will show up here.";
                    }
                    HorizontalLayout {
                        alignment: center;
                        Btn {
                            label: "Find something to play";
                            primary: true;
                            pad_h: Space.xl;
                            clicked => { root.go_play(); }
                        }
                    }
                }
            }
        }
    }
}

export component PlayScreen inherits Rectangle {
    in-out property <string> query;
    in property <bool> searching: false;
    in property <string> last_query;

    in property <[GameTile]> games;
    in property <[DetailItem]> players;
    in property <[DetailItem]> groups;
    in property <[string]> recents;

    callback search(string);
    callback open(string);
    callback play(string);
    callback favorite(string);
    callback open_player(string);
    callback open_group(string);
    callback clear_recents();

    /// 0 Games · 1 People · 2 Groups
    in-out property <int> filter: 0;

    property <bool> has_results:
        root.games.length > 0 || root.players.length > 0 || root.groups.length > 0;

    property <bool> show_games: root.filter == 0;
    property <bool> show_people: root.filter == 1;
    property <bool> show_groups: root.filter == 2;

    background: Theme.bg_0;

    Texture { width: 100%; height: 100%; }

    ScrollView {
        VerticalLayout {
            alignment: start;
            padding: Space.xl;
            spacing: Space.xl;


            if root.has_results || root.searching: HorizontalLayout {
                alignment: start;
                Segmented {
                    options: [
                        root.games.length > 0 ? "Games " + root.games.length : "Games",
                        root.players.length > 0 ? "People " + root.players.length : "People",
                        root.groups.length > 0 ? "Groups " + root.groups.length : "Groups",
                    ];
                    current <=> root.filter;
                }
            }

            if !root.has_results && !root.searching && root.last_query == "" && root.recents.length > 0:
            VerticalLayout {
                spacing: Space.md;
                HorizontalLayout {
                    spacing: Space.sm;
                    Text {
                        text: "Recent searches";
                        color: Theme.text_dim;
                        font-size: Type.small;
                        font-weight: Type.w_medium;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    IconBtn { glyph: "×"; clicked => { root.clear_recents(); } }
                }
                HorizontalLayout {
                    spacing: Space.sm;
                    alignment: start;
                    for r in root.recents: Chip {
                        label: r;
                        clicked => { root.query = r; root.search(r); }
                    }
                }
            }

            if !root.has_results && !root.searching && root.last_query == "" && root.recents.length == 0:
            EmptyState {
                height: 200px;
                title: "Search Roblox";
                hint: "Use the bar at the top for a game, a person, a group, or a link.";
            }

            if !root.has_results && !root.searching && root.last_query != "": EmptyState {
                height: 200px;
                title: "No results for \"" + root.last_query + "\"";
                hint: "Try a different spelling, or paste the game's link instead.";
            }

            if root.has_results && !root.searching
               && ((root.show_games && root.games.length == 0)
                || (root.show_people && root.players.length == 0)
                || (root.show_groups && root.groups.length == 0)): EmptyState {
                height: 160px;
                title: "Nothing here";
                hint: "That search matched something in the other tabs.";
            }

            if root.show_games && root.games.length > 0: VerticalLayout {
                spacing: Space.md;
                SectionHead { title: "Games"; count_label: root.games.length + ""; }
                GameGrid {
                    games: root.games;
                    open(id) => { root.open(id); }
                    play(id) => { root.play(id); }
                    favorite(id) => { root.favorite(id); }
                }
            }

            if root.show_people && root.players.length > 0: VerticalLayout {
                spacing: Space.md;
                SectionHead { title: "People"; count_label: root.players.length + ""; }
                ItemGrid {
                    items: root.players;
                    tile_min: 132px;
                    open(id, kind) => { root.open_player(id); }
                }
            }

            if root.show_groups && root.groups.length > 0: VerticalLayout {
                spacing: Space.md;
                SectionHead { title: "Groups"; count_label: root.groups.length + ""; }
                ItemGrid {
                    items: root.groups;
                    tile_min: 132px;
                    open(id, kind) => { root.open_group(id); }
                }
            }
        }
    }
}
