import { Theme, Space, Type, Motion, Layout } from "theme.slint";
import { Btn, IconBtn, Segmented, Spinner, EmptyState } from "components.slint";
import { GameTile, WearItem, SubPlace, ServerRow, DetailItem, GameDetailData, FriendRow, GroupRow, MacroRow, MacroStepRow } from "types.slint";
import { Sidebar, TopBar, NavEntry, ExpiredBanner, AccountMismatchBanner } from "shell.slint";
import { SignInScreen, SignInPhase } from "signin.slint";
import { HomeScreen, PlayScreen } from "screens.slint";
import { GameScreen } from "game.slint";
import { FriendsScreen } from "friends.slint";
import { ProfileScreen, ProfileData } from "profile.slint";
import { GroupScreen, GroupData } from "group.slint";
import { AvatarScreen } from "avatar.slint";
import { MacrosScreen, StepEditor } from "macros.slint";
import { LibraryScreen, PlayStat } from "library.slint";
import { SettingsScreen, AccountRow } from "settings.slint";

export { Theme, SignInPhase, ProfileData, GroupData, PlayStat, AccountRow }

export component MainWindow inherits Window {
    title: "RoJoin";
    background: Theme.bg_0;
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 900px;
    min-height: 580px;

    in property <bool> signed_in: false;
    in property <bool> session_expired: false;
    in property <string> account_name;
    in property <image> account_avatar;
    in property <int> accounts_count: 0;
    in property <string> app_version: "0.1.0";

    in property <SignInPhase> signin_phase: SignInPhase.idle;
    in property <string> signin_code;
    in property <image> signin_qr;
    in property <string> signin_error;

    callback signin_start();
    callback signin_open_browser();
    callback signin_cancel();
    callback signin_back();

    in property <[NavEntry]> nav;
    in-out property <int> section: 0;
    /// 0 = the current section, 1 = a pushed game detail page.
    in property <int> view_kind: 0;
    in property <bool> can_back: false;
    in property <bool> busy: false;
    in-out property <string> top_query;

    callback navigate(int);
    callback nav_back();
    callback open_settings();
    callback open_account();
    callback top_submit(string);
    callback top_live_search(string);
    callback dismiss_expired();

    in property <bool> account_mismatch: false;
    in property <string> client_account;
    callback dismiss_mismatch();

    in property <string> greeting;
    in property <string> date_label;
    in property <bool> home_loading: false;
    in property <GameTile> hero;
    in property <bool> has_hero: false;
    in property <[GameTile]> recent;
    in property <[GameTile]> favorites;
    in property <int> friends_online: 0;
    in property <int> friend_requests: 0;
    in property <[GameTile]> pinned;
    in property <bool> show_friends: true;
    in property <bool> show_hero: true;
    in property <bool> show_pinned: true;
    in property <bool> show_recent: true;
    in property <bool> show_favorites: true;

    callback toggle_home_section(int);
    callback unpin_game(string);

    in-out property <string> play_query;
    in property <bool> play_searching: false;
    in property <string> play_last_query;
    in property <[GameTile]> play_games;
    in property <[DetailItem]> play_players;
    in property <[DetailItem]> play_groups;
    in property <[string]> play_recents;

    callback play_search(string);
    callback clear_recents();

    in property <[FriendRow]> friend_rows;
    in property <[DetailItem]> requests_list;
    in property <bool> friends_loading: false;
    in property <string> request_status;
    in property <int> friends_in_game: 0;
    in-out property <string> friend_filter;

    callback refresh_friends();
    callback open_friend(string);
    callback join_friend(string);
    callback pin_friend(string);
    callback notify_friend(string);
    callback toggle_friend_group(string);
    callback accept_request(string);
    callback decline_request(string);
    callback friend_filter_changed(string);

    in property <GameDetailData> game;
    in property <bool> game_loading: false;
    in property <bool> launching: false;
    in property <string> launch_error;
    in property <[SubPlace]> sub_places;
    in property <[ServerRow]> servers;
    in property <bool> servers_loading: false;
    in property <[DetailItem]> passes;
    in property <[DetailItem]> badges;
    in property <[GameTile]> related;
    in-out property <int> game_tab: 0;
    in-out property <int> server_sort: 0;
    in-out property <string> badge_title;
    in-out property <string> badge_text;

    callback open_game(string);
    callback play_game(string);
    callback play_sub_place(string);
    callback join_server(string);
    callback toggle_favorite(string);
    callback toggle_notify();
    callback copy_link();
    callback copy_id();
    callback inspect_badge(string);
    callback open_browser();
    callback set_server_sort(int);
    callback open_player(string);
    callback open_group(string);
    callback open_creator();

    in property <ProfileData> profile;
    in property <bool> profile_loading: false;
    in property <bool> profile_busy: false;
    in property <[GroupRow]> profile_groups;
    in property <[DetailItem]> profile_badges;
    in property <[GameTile]> profile_favorites;
    in-out property <int> profile_tab: 0;

    callback profile_join();
    callback profile_add_friend();
    callback profile_unfriend();
    callback profile_follow();
    callback profile_message();

    in property <GroupData> group;
    in property <bool> group_loading: false;
    in property <bool> group_busy: false;
    in property <[GameTile]> group_games;

    callback group_join();
    callback group_leave();
    callback open_group_owner();

    in property <image> av_body;
    in property <bool> av_body_loading: false;
    in property <[WearItem]> av_items;
    in property <[string]> av_categories;
    in property <[DetailItem]> av_outfits;
    in property <[DetailItem]> av_worn;
    in-out property <int> av_category: 0;
    in-out property <int> av_tab: 0;
    in property <bool> av_items_loading: false;
    in property <bool> av_busy: false;
    in property <int> av_worn_count: 0;
    in property <bool> av_is_r15: true;

    callback av_pick_category(int);
    callback av_toggle(string);
    callback av_wear_outfit(string);
    callback av_save_outfit();
    callback av_set_type(bool);
    callback av_refresh();

    in property <[MacroRow]> macros;
    in property <bool> macro_available: true;
    in property <string> macro_hint;
    in property <string> macro_backend;
    in property <int> macro_active: 0;
    in property <string> macro_binding;
    in property <string> macro_io_status;

    callback macro_toggle_run(string);
    callback macro_toggle_enabled(string);
    callback macro_edit(string);
    callback macro_rebind(string);
    callback macro_stop_all();
    callback macro_import();
    callback macro_export();
    callback macro_open_credit();

    in property <bool> editor_open: false;
    in property <string> editor_title;
    in property <[MacroStepRow]> editor_steps;
    in property <[string]> editor_keys;
    in property <int> editor_mode;
    in property <int> editor_gap;
    in property <string> editor_hotkey;
    in property <bool> editor_capturing: false;

    callback editor_close();
    callback editor_set_mode(int);
    callback editor_set_gap(int);
    callback editor_set_amount(int, int);
    callback editor_set_delta(int, int, int);
    callback editor_set_key(int, string);
    callback editor_move(int, int);
    callback editor_remove(int);
    callback editor_add(int);
    callback editor_capture();
    callback editor_reset();

    in property <[PlayStat]> most_played;
    in property <string> total_playtime;
    in property <int> games_played: 0;
    in property <int> total_launches: 0;
    in-out property <int> library_tab: 0;

    in property <[AccountRow]> accounts;
    in property <[DetailItem]> notify_friends_list;
    in property <[DetailItem]> notify_games_list;
    in property <bool> dark: true;
    in property <bool> notify_requests: false;
    in property <bool> link_handler: false;
    in property <string> data_dir;
    in property <string> update_status;
    in property <bool> checking_update: false;

    callback switch_account(string);
    callback remove_account(string);
    callback add_account();
    callback set_dark(bool);
    callback set_notify_requests(bool);
    callback set_link_handler(bool);
    callback unsub_friend(string);
    callback unsub_game(string);
    callback open_data_dir();
    callback check_update();

    in property <bool> macros_enabled: true;
    in property <bool> only_when_focused: true;
    in property <bool> focus_detectable: true;
    in property <string> panic_key;
    in property <bool> binding_panic: false;
    in property <float> ui_scale: 1.0;
    in property <[string]> sections;
    in property <int> startup_section: 0;
    in property <int> presence_secs: 60;
    in property <bool> confirm_destructive: true;
    in property <string> cache_summary;

    callback set_macros_enabled(bool);
    callback set_only_when_focused(bool);
    callback bind_panic_key();
    callback set_ui_scale(float);
    callback set_startup_section(int);
    callback set_presence_secs(int);
    callback set_confirm_destructive(bool);
    callback clear_caches();

    if !root.signed_in: SignInScreen {
        width: 100%;
        height: 100%;
        phase: root.signin_phase;
        code: root.signin_code;
        qr: root.signin_qr;
        error: root.signin_error;
        account_name: root.account_name;
        accounts_count: root.accounts_count;
        request_code => { root.signin_start(); }
        open_browser => { root.signin_open_browser(); }
        cancel => { root.signin_cancel(); }
        back => { root.signin_back(); }
    }

    if root.signed_in: keys := FocusScope {
        init => { self.focus(); }

        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.nav_back();
                return accept;
            }
            if (e.modifiers.control && e.text == "l") {
                topbar.focus_search();
                return accept;
            }
            if (e.text == "/") {
                topbar.focus_search();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0;

            if root.session_expired: ExpiredBanner {
                sign_in => { root.signin_start(); }
                dismiss => { root.dismiss_expired(); }
            }

            if root.account_mismatch: AccountMismatchBanner {
                client_account: root.client_account;
                rojoin_account: root.account_name;
                dismiss => { root.dismiss_mismatch(); }
            }

            HorizontalLayout {
                spacing: 0;

                Sidebar {
                    entries: root.nav;
                    active: root.section < root.nav.length ? root.section : -1;
                    app_version: root.app_version;
                    navigate(i) => { root.navigate(i); }
                    open_settings => { root.open_settings(); }
                }
                Rectangle { width: Theme.hairline; background: Theme.line; }

                VerticalLayout {
                    spacing: 0;
                    horizontal-stretch: 1;

                    topbar := TopBar {
                        can_back: root.can_back;
                        busy: root.busy;
                        account_name: root.account_name;
                        account_avatar: root.account_avatar;
                        query <=> root.top_query;
                        back => { root.nav_back(); }
                        submit(q) => { root.top_submit(q); }
                        live_search(q) => { root.top_live_search(q); }
                        open_account => { root.open_account(); }
                    }
                    Rectangle { height: Theme.hairline; background: Theme.line; }

                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;

                        if root.view_kind == 1: GameScreen {
                            width: 100%;
                            height: 100%;
                            game: root.game;
                            loading: root.game_loading;
                            launching: root.launching;
                            launch_error: root.launch_error;
                            sub_places: root.sub_places;
                            servers: root.servers;
                            servers_loading: root.servers_loading;
                            passes: root.passes;
                            badges: root.badges;
                            related: root.related;
                            tab <=> root.game_tab;
                            server_sort <=> root.server_sort;
                            badge_title <=> root.badge_title;
                            badge_text <=> root.badge_text;
                            play => { root.play_game(root.game.root_place_id); }
                            play_sub_place(id) => { root.play_sub_place(id); }
                            join_server(id) => { root.join_server(id); }
                            toggle_favorite => { root.toggle_favorite(root.game.universe_id); }
                            toggle_notify => { root.toggle_notify(); }
                            copy_link => { root.copy_link(); }
                            copy_id => { root.copy_id(); }
                            open_browser => { root.open_browser(); }
                            set_server_sort(s) => { root.set_server_sort(s); }
                            inspect_badge(id) => { root.inspect_badge(id); }
                            open_related(id) => { root.open_game(id); }
                            favorite_related(id) => { root.toggle_favorite(id); }
                            open_creator => { root.open_creator(); }
                        }

                        if root.view_kind == 2: ProfileScreen {
                            width: 100%;
                            height: 100%;
                            profile: root.profile;
                            loading: root.profile_loading;
                            busy: root.profile_busy;
                            groups: root.profile_groups;
                            badges: root.profile_badges;
                            favorites: root.profile_favorites;
                            tab <=> root.profile_tab;
                            join => { root.profile_join(); }
                            add_friend => { root.profile_add_friend(); }
                            unfriend => { root.profile_unfriend(); }
                            follow => { root.profile_follow(); }
                            message => { root.profile_message(); }
                            open_browser => { root.open_browser(); }
                            copy_link => { root.copy_link(); }
                            copy_id => { root.copy_id(); }
                            open_group(id) => { root.open_group(id); }
                            open_game(id) => { root.open_game(id); }
                        }

                        if root.view_kind == 3: GroupScreen {
                            width: 100%;
                            height: 100%;
                            group: root.group;
                            loading: root.group_loading;
                            busy: root.group_busy;
                            games: root.group_games;
                            join => { root.group_join(); }
                            leave => { root.group_leave(); }
                            open_owner => { root.open_group_owner(); }
                            open_game(id) => { root.open_game(id); }
                            open_browser => { root.open_browser(); }
                            copy_link => { root.copy_link(); }
                            copy_id => { root.copy_id(); }
                        }

                        if root.view_kind == 0 && root.section == 0: HomeScreen {
                            width: 100%;
                            height: 100%;
                            greeting: root.greeting;
                            date_label: root.date_label;
                            loading: root.home_loading;
                            launching: root.launching;
                            hero: root.hero;
                            has_hero: root.has_hero;
                            recent: root.recent;
                            favorites: root.favorites;
                            friends_online: root.friends_online;
                            friend_requests: root.friend_requests;
                            pinned: root.pinned;
                            show_friends: root.show_friends;
                            show_hero: root.show_hero;
                            show_pinned: root.show_pinned;
                            show_recent: root.show_recent;
                            show_favorites: root.show_favorites;
                            unpin(id) => { root.unpin_game(id); }
                            open(id) => { root.open_game(id); }
                            play(id) => { root.play_game(id); }
                            favorite(id) => { root.toggle_favorite(id); }
                            play_hero => { root.play_game(root.hero.id); }
                            go_friends => { root.navigate(2); }
                            go_play => { root.navigate(1); }
                        }

                        if root.view_kind == 0 && root.section == 1: PlayScreen {
                            width: 100%;
                            height: 100%;
                            query <=> root.play_query;
                            searching: root.play_searching;
                            last_query: root.play_last_query;
                            games: root.play_games;
                            players: root.play_players;
                            groups: root.play_groups;
                            recents: root.play_recents;
                            search(q) => { root.play_search(q); }
                            open(id) => { root.open_game(id); }
                            play(id) => { root.play_game(id); }
                            favorite(id) => { root.toggle_favorite(id); }
                            open_player(id) => { root.open_player(id); }
                            open_group(id) => { root.open_group(id); }
                            clear_recents => { root.clear_recents(); }
                        }

                        if root.view_kind == 0 && root.section == 2: FriendsScreen {
                            width: 100%;
                            height: 100%;
                            rows: root.friend_rows;
                            requests: root.requests_list;
                            loading: root.friends_loading;
                            request_status: root.request_status;
                            in_game: root.friends_in_game;
                            online: root.friends_online;
                            filter <=> root.friend_filter;
                            refresh => { root.refresh_friends(); }
                            filter_changed(q) => { root.friend_filter_changed(q); }
                            open(id) => { root.open_friend(id); }
                            join(id) => { root.join_friend(id); }
                            pin(id) => { root.pin_friend(id); }
                            notify(id) => { root.notify_friend(id); }
                            toggle_group(label) => { root.toggle_friend_group(label); }
                            accept(id) => { root.accept_request(id); }
                            decline(id) => { root.decline_request(id); }
                        }

                        if root.view_kind == 0 && root.section == 4: AvatarScreen {
                            width: 100%;
                            height: 100%;
                            body: root.av_body;
                            body_loading: root.av_body_loading;
                            items: root.av_items;
                            categories: root.av_categories;
                            outfits: root.av_outfits;
                            worn: root.av_worn;
                            category <=> root.av_category;
                            tab <=> root.av_tab;
                            items_loading: root.av_items_loading;
                            busy: root.av_busy;
                            worn_count: root.av_worn_count;
                            is_r15: root.av_is_r15;
                            pick_category(i) => { root.av_pick_category(i); }
                            toggle(id) => { root.av_toggle(id); }
                            wear_outfit(id) => { root.av_wear_outfit(id); }
                            save_outfit => { root.av_save_outfit(); }
                            set_avatar_type(r15) => { root.av_set_type(r15); }
                            refresh => { root.av_refresh(); }
                        }

                        if root.view_kind == 0 && root.section == 5: MacrosScreen {
                            width: 100%;
                            height: 100%;
                            macros: root.macros;
                            available: root.macro_available;
                            permission_hint: root.macro_hint;
                            backend_name: root.macro_backend;
                            active_count: root.macro_active;
                            binding_id: root.macro_binding;
                            toggle_run(id) => { root.macro_toggle_run(id); }
                            toggle_enabled(id) => { root.macro_toggle_enabled(id); }
                            edit(id) => { root.macro_edit(id); }
                            rebind(id) => { root.macro_rebind(id); }
                            stop_all => { root.macro_stop_all(); }
                            import_macros => { root.macro_import(); }
                            export_macros => { root.macro_export(); }
                            io_status: root.macro_io_status;
                        }

                        if root.view_kind == 0 && root.section == 3: LibraryScreen {
                            width: 100%;
                            height: 100%;
                            recent: root.recent;
                            favorites: root.favorites;
                            most_played: root.most_played;
                            total_playtime: root.total_playtime;
                            games_played: root.games_played;
                            total_launches: root.total_launches;
                            tab <=> root.library_tab;
                            open(id) => { root.open_game(id); }
                            play(id) => { root.play_game(id); }
                            favorite(id) => { root.toggle_favorite(id); }
                        }

                        if root.view_kind == 0 && root.section == 6: SettingsScreen {
                            width: 100%;
                            height: 100%;
                            accounts: root.accounts;
                            notify_friends: root.notify_friends_list;
                            notify_games: root.notify_games_list;
                            dark: root.dark;
                            notify_requests: root.notify_requests;
                            link_handler: root.link_handler;
                            app_version: root.app_version;
                            data_dir: root.data_dir;
                            update_status: root.update_status;
                            checking_update: root.checking_update;
                            switch_account(id) => { root.switch_account(id); }
                            remove_account(id) => { root.remove_account(id); }
                            add_account => { root.add_account(); }
                            set_dark(v) => { root.set_dark(v); }
                            show_friends: root.show_friends;
                            show_hero: root.show_hero;
                            show_pinned: root.show_pinned;
                            show_recent: root.show_recent;
                            show_favorites: root.show_favorites;
                            toggle_home_section(k) => { root.toggle_home_section(k); }
                            set_notify_requests(v) => { root.set_notify_requests(v); }
                            set_link_handler(v) => { root.set_link_handler(v); }
                            unsub_friend(id) => { root.unsub_friend(id); }
                            unsub_game(id) => { root.unsub_game(id); }
                            open_data_dir => { root.open_data_dir(); }
                            check_update => { root.check_update(); }
                            macros_enabled: root.macros_enabled;
                            only_when_focused: root.only_when_focused;
                            focus_detectable: root.focus_detectable;
                            panic_key: root.panic_key;
                            binding_panic: root.binding_panic;
                            macro_backend: root.macro_backend;
                            ui_scale: root.ui_scale;
                            sections: root.sections;
                            startup_section: root.startup_section;
                            presence_secs: root.presence_secs;
                            confirm_destructive: root.confirm_destructive;
                            cache_summary: root.cache_summary;
                            set_macros_enabled(v) => { root.set_macros_enabled(v); }
                            set_only_when_focused(v) => { root.set_only_when_focused(v); }
                            bind_panic_key => { root.bind_panic_key(); }
                            set_ui_scale(v) => { root.set_ui_scale(v); }
                            set_startup_section(v) => { root.set_startup_section(v); }
                            set_presence_secs(v) => { root.set_presence_secs(v); }
                            set_confirm_destructive(v) => { root.set_confirm_destructive(v); }
                            clear_caches => { root.clear_caches(); }
                        }
                    }
                }
            }
        }

        StepEditor {
            open: root.editor_open;
            title: root.editor_title;
            steps: root.editor_steps;
            keys: root.editor_keys;
            mode: root.editor_mode;
            cycle_gap: root.editor_gap;
            hotkey: root.editor_hotkey;
            capturing: root.editor_capturing;
            close => { root.editor_close(); }
            set_mode(m) => { root.editor_set_mode(m); }
            set_cycle_gap(g) => { root.editor_set_gap(g); }
            set_step_amount(i, v) => { root.editor_set_amount(i, v); }
            set_step_delta(i, x, y) => { root.editor_set_delta(i, x, y); }
            set_step_key(i, k) => { root.editor_set_key(i, k); }
            move_step(i, d) => { root.editor_move(i, d); }
            remove_step(i) => { root.editor_remove(i); }
            add_step(k) => { root.editor_add(k); }
            capture_hotkey => { root.editor_capture(); }
            reset => { root.editor_reset(); }
        }
    }
}
