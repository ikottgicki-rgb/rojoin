import { Theme, Space, Type, Motion, Layout } from "theme.slint";
import { Avatar, Btn, IconBtn, Badge, Spinner, EmptyState, Skeleton } from "components.slint";
import { ChatConv, ChatMsg } from "types.slint";
import { ListView } from "std-widgets.slint";

// Direct messages.
//
// Bubble sizing is the crux here and it is done by the layout, not by hand:
// `alignment` makes a bubble hug its content and `max-width` caps the wrap
// point. Deriving width from `text.preferred-width` instead creates a
// dependency cycle (text width <- bubble width <- text width).

component ConvRow inherits Rectangle {
    in property <ChatConv> conv;
    in property <bool> selected;
    callback clicked();

    height: 60px;
    background: root.selected ? Theme.bg_3 : cta.has-hover ? Theme.bg_2 : transparent;
    animate background { duration: Motion.instant; easing: Motion.ease; }

    if root.selected: Rectangle {
        x: 0;
        width: 2px;
        height: 100%;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.sm;

        VerticalLayout {
            alignment: center;
            Avatar {
                source: root.conv.avatar;
                size_px: 36px;
                show_presence: true;
                online: root.conv.online;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            HorizontalLayout {
                spacing: Space.sm;
                Text {
                    text: root.conv.title;
                    color: Theme.text;
                    font-size: Type.body;
                    font-weight: root.conv.unread > 0 ? Type.w_bold : Type.w_medium;
                    overflow: elide;
                    wrap: no-wrap;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.conv.time;
                    color: Theme.text_mute;
                    font-size: Type.micro;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: Space.sm;
                Text {
                    text: root.conv.preview;
                    color: root.conv.unread > 0 ? Theme.text_dim : Theme.text_mute;
                    font-size: Type.small;
                    overflow: elide;
                    wrap: no-wrap;
                }
                Rectangle { horizontal-stretch: 1; }
                if root.conv.unread > 0: Badge { count: root.conv.unread; }
            }
        }
    }

    cta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Bubble inherits HorizontalLayout {
    in property <ChatMsg> msg;
    in property <length> max_w;
    alignment: root.msg.mine ? end : start;

    Rectangle {
        max-width: root.max_w;
        background: root.msg.mine ? Theme.accent : Theme.bg_2;
        border-radius: Theme.radius;
        border-width: root.msg.mine ? 0px : Theme.hairline;
        border-color: Theme.line;

        VerticalLayout {
            padding-left: Space.md;
            padding-right: Space.md;
            padding-top: Space.sm;
            padding-bottom: Space.sm;

            Text {
                text: root.msg.body;
                color: root.msg.mine ? Theme.on_accent : Theme.text;
                font-size: Type.body;
                wrap: word-wrap;
            }
        }
    }
}

component MsgRow inherits Rectangle {
    in property <ChatMsg> msg;
    height: mlay.preferred-height;

    mlay := VerticalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        padding-top: root.msg.show_header ? Space.md : Space.xxs;
        spacing: Space.xs;

        if root.msg.show_header: HorizontalLayout {
            spacing: Space.sm;
            padding-left: root.msg.mine ? 0px : 34px;
            alignment: root.msg.mine ? end : start;
            Text {
                text: root.msg.sender;
                color: Theme.text_dim;
                font-size: Type.caption;
                font-weight: Type.w_medium;
            }
            Text {
                text: root.msg.time;
                color: Theme.text_mute;
                font-size: Type.micro;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: Space.sm;
            if !root.msg.mine: Rectangle {
                width: 26px;
                VerticalLayout {
                    alignment: start;
                    if root.msg.show_header: Avatar { source: root.msg.avatar; size_px: 26px; }
                }
            }
            Bubble {
                msg: root.msg;
                max_w: Math.max(140px, root.width * 0.62);
                horizontal-stretch: 1;
            }
        }
    }
}

export component ChatScreen inherits Rectangle {
    in property <[ChatConv]> convs;
    in property <[ChatMsg]> msgs;
    in property <int> selected: -1;
    in property <bool> convs_loading: false;
    in property <bool> msgs_loading: false;
    in property <bool> sending: false;
    in property <string> title;
    in-out property <string> draft;

    callback select(int);
    callback send(string);
    callback refresh();
    callback open_profile();

    background: Theme.bg_0;

    HorizontalLayout {
        spacing: 0;

        // --- conversation list --------------------------------------------
        Rectangle {
            width: 272px;
            background: Theme.bg_1;
            VerticalLayout {
                spacing: 0;

                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: Space.md;
                        padding-right: Space.sm;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Messages";
                                color: Theme.text;
                                font-size: Type.lead;
                                font-weight: Type.w_bold;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            if root.convs_loading: Spinner { size_px: 14px; }
                            if !root.convs_loading: IconBtn {
                                glyph: "⟳";
                                clicked => { root.refresh(); }
                            }
                        }
                    }
                }
                Rectangle { height: Theme.hairline; background: Theme.line; }

                if root.convs_loading && root.convs.length == 0: VerticalLayout {
                    padding: Space.md;
                    spacing: Space.sm;
                    alignment: start;
                    for s in [0, 1, 2, 3, 4]: Skeleton { height: 48px; }
                }

                if !root.convs_loading && root.convs.length == 0: EmptyState {
                    vertical-stretch: 1;
                    title: "No conversations";
                    hint: "Message someone from their profile to start one.";
                }

                if root.convs.length > 0: ListView {
                    vertical-stretch: 1;
                    for c[i] in root.convs: ConvRow {
                        conv: c;
                        selected: root.selected == i;
                        clicked => { root.select(i); }
                    }
                }
            }
        }
        Rectangle { width: Theme.hairline; background: Theme.line; }

        // --- message pane ---------------------------------------------------
        VerticalLayout {
            spacing: 0;
            horizontal-stretch: 1;

            if root.selected < 0: EmptyState {
                vertical-stretch: 1;
                title: "Pick a conversation";
                hint: "Your messages will appear here.";
            }

            if root.selected >= 0: Rectangle {
                height: 48px;
                background: Theme.bg_1;
                HorizontalLayout {
                    padding-left: Space.lg;
                    padding-right: Space.sm;
                    spacing: Space.sm;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: titletext.preferred-width;
                            height: titletext.preferred-height;
                            titletext := Text {
                                text: root.title;
                                color: tta.has-hover ? Theme.accent : Theme.text;
                                font-size: Type.body;
                                font-weight: Type.w_bold;
                                animate color { duration: Motion.fast; easing: Motion.ease; }
                            }
                            tta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open_profile(); }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        if root.msgs_loading: Spinner { size_px: 14px; }
                    }
                }
            }
            if root.selected >= 0: Rectangle { height: Theme.hairline; background: Theme.line; }

            if root.selected >= 0 && root.msgs.length > 0: ListView {
                vertical-stretch: 1;
                for m in root.msgs: MsgRow { msg: m; }
            }

            if root.selected >= 0 && root.msgs.length == 0 && !root.msgs_loading: EmptyState {
                vertical-stretch: 1;
                title: "No messages yet";
                hint: "Say something.";
            }

            // --- composer ---------------------------------------------------
            if root.selected >= 0: Rectangle { height: Theme.hairline; background: Theme.line; }
            if root.selected >= 0: Rectangle {
                height: 56px;
                background: Theme.bg_1;
                HorizontalLayout {
                    padding: Space.md;
                    spacing: Space.sm;

                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.bg_2;
                        border-radius: Theme.radius;
                        border-width: Theme.hairline;
                        border-color: input.has-focus ? Theme.accent : Theme.line;
                        animate border-color { duration: Motion.fast; easing: Motion.ease; }

                        input := TextInput {
                            x: Space.md;
                            width: parent.width - Space.md * 2;
                            height: 100%;
                            text <=> root.draft;
                            color: Theme.text;
                            font-size: Type.body;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => {
                                if (root.draft != "") { root.send(root.draft); }
                            }
                        }
                        if root.draft == "": Text {
                            x: Space.md;
                            width: parent.width - Space.md * 2;
                            height: 100%;
                            text: "Message";
                            color: Theme.text_mute;
                            font-size: Type.body;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                        }
                    }

                    Btn {
                        label: root.sending ? "Sending…" : "Send";
                        primary: true;
                        enabled: root.draft != "" && !root.sending;
                        clicked => { root.send(root.draft); }
                    }
                }
            }
        }
    }
}
